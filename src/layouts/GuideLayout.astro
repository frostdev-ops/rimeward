---
import MarketingLayout from './MarketingLayout.astro';
import '../styles/guides.css';

interface Props {
  title: string;
  description: string;
  path: string;
  project: string;
  duration: string;
  chapters: Array<{ id: string; title: string }>;
}

const { title, description, path, project, duration, chapters } = Astro.props;
const product = project.toLowerCase();
const projectHref = product === 'frostsim' ? 'https://sim.frostdev.io' : product === 'loothing' ? 'https://loothing.xyz' : `/${product}`;
const flows: Record<string, string[]> = {
  rimeward: ['Open a project', 'Connect your wards', 'Review the result'],
  crosspane: ['Pair your devices', 'Arrange your desk', 'Move between them'],
  rimewire: ['Define the work', 'Share the evidence', 'Make the handoff'],
  frostsim: ['Import a character', 'Run a simulation', 'Compare the result'],
  loothing: ['Prepare the raid', 'Review the loot', 'Record the award'],
};
const flow = flows[product] ?? ['Get set up', 'Put it to work', 'Check the result'];
---

<MarketingLayout title={`${title.replace(/\.$/, '')} — Frostdev`} description={description} path={path}>
  <div class="guide-page" data-project={product}>
    <div class="guide-reading-progress" hidden aria-hidden="true"><span></span></div>
    <a class="guide-back" href="/guides"><span aria-hidden="true">←</span> All guides</a>
    <header class="guide-hero">
      <div class="guide-intro">
        <p class="guide-eyebrow"><a href={projectHref}>{project}</a> <span aria-hidden="true">/</span> Field guide</p>
        <h1>{title}</h1>
        <p class="guide-lead">{description}</p>
        <div class="guide-meta"><span>{duration}</span><span>{chapters.length} chapters</span><span>By Frostdev</span><span>Updated <time datetime="2026-10-11">October 11, 2026</time></span></div>
      </div>
      <div class="guide-visual">
        <slot name="visual">
          <div class="guide-overview" aria-label={`${project} guide overview`}>
            <div class="guide-overview-top"><span class="guide-status-dot" aria-hidden="true"></span><span>{project}</span><span class="guide-overview-tag">A practical path</span></div>
            <ol class="guide-overview-flow">
              {flow.map((step, i) => <li style={`--step:${i}`}><span class="guide-overview-number">0{i + 1}</span><span>{step}</span>{i < flow.length - 1 && <span class="guide-overview-line" aria-hidden="true"></span>}</li>)}
            </ol>
            <p class="guide-overview-footer">Small steps. A result you can verify.</p>
          </div>
        </slot>
      </div>
    </header>
    <div class="guide-reading-grid">
      <aside class="guide-sidebar">
        <details class="guide-contents" open>
          <summary>In this guide <span aria-hidden="true">↕</span></summary>
          <nav aria-label="Guide chapters">
            <ol>{chapters.map((chapter, i) => <li><a href={`#${chapter.id}`} data-guide-chapter={chapter.id}><span class="guide-chapter-number">{String(i + 1).padStart(2, '0')}</span><span>{chapter.title}</span></a></li>)}</ol>
          </nav>
        </details>
        <a class="guide-project-link" href={projectHref}>Explore {project} <span aria-hidden="true">↗</span></a>
      </aside>
      <article class="guide-article"><slot /></article>
    </div>
    <div class="guide-endcap"><p>Keep exploring.</p><a href="/guides">Find your next guide <span aria-hidden="true">→</span></a></div>
  </div>
</MarketingLayout>

<script>
  const guide = document.querySelector<HTMLElement>('.guide-page');
  if (guide) {
    const article = guide.querySelector<HTMLElement>('.guide-article');
    const chapters = [...guide.querySelectorAll<HTMLAnchorElement>('[data-guide-chapter]')];
    const sections = chapters.map((link) => document.getElementById(link.dataset.guideChapter ?? ''));
    const progress = guide.querySelector<HTMLElement>('.guide-reading-progress');
    const bar = progress?.querySelector<HTMLElement>('span');
    if (article && progress && bar) {
      progress.hidden = false;
      let queued = false;
      const update = () => {
        queued = false;
        const bounds = article.getBoundingClientRect();
        const distance = Math.max(1, bounds.height - window.innerHeight);
        bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -bounds.top / distance))})`;
        let active = 0;
        sections.forEach((section, i) => { if (section && section.getBoundingClientRect().top <= 180) active = i; });
        chapters.forEach((link, i) => {
          if (i === active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      update();
    }
  }
</script>
