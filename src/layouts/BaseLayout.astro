---
import '../styles/frost.css';
import ThemeScript from '../components/ThemeScript.astro';
import SearchSelect from '../components/SearchSelect.astro';
import { parseTheme, themeColor, themeHtmlAttrs } from '../lib/theme.ts';
import { siteInfo } from '../lib/site.ts';

interface Props {
  title: string;
  description?: string;
  /** Splash sets this: index is the only page meant for crawlers. */
  index?: boolean;
  wardWindow?: boolean;
}

const { title, description = siteInfo().name, index = false, wardWindow = false } = Astro.props;

// Per-user theme rides locals.user (populated by middleware from the session
// join). Knob values land as attributes on <html> — SSR'd, so no flash.
const theme = parseTheme(Astro.locals.user?.theme ?? null);
---

<!doctype html>
<html lang="en" {...themeHtmlAttrs(theme)} data-ward-window={wardWindow ? '' : undefined}>
  <head>
    <ThemeScript />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor(theme)} />
    <title>{title}</title>
    <link rel="icon" href="/brand/favicon" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface-2 text-ink">
    {/* The other half of the splash/valley gate: arrive through the dive and
        the page starts covered in light, then fades out. Every page has it —
        the dive lands on /login, on a wizard step, or on /dash. */}
    {!wardWindow && <div id="gate-flash"></div>}
    <script is:inline>
      try {
        if (sessionStorage.getItem('fd-gate') === '1') {
          sessionStorage.removeItem('fd-gate');
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
            document.getElementById('gate-flash')?.classList.add('flash-out');
        }
      } catch {}
    </script>
    <slot />
    {/* Upgrades every <select> on the page, whenever it arrives. */}
    <SearchSelect />
    <script>
      // The three.js background, when the saved theme asks for one. Reads what
      // themeHtmlAttrs stamped on <html>; three arrives lazily inside, so
      // flat/aurora/image users download none of it. (Public pages stamp
      // nothing — locals.user, and so the theme, is undefined. A valley page
      // that IS signed in, like /desktop/start, is declined inside: the
      // terrain is that page's backdrop.)
      import { bootBackground } from '../scripts/app/background.ts';
      bootBackground();
    </script>
  </body>
</html>
