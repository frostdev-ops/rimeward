---
import { ICONS } from '../../lib/icon-names.ts';
import { iconSvg } from '../../lib/icons.ts';

const steps = [
  { title: 'Arrange displays', text: 'Place each machine where it sits on your desk. Apply the layout. The pointer crosses where displays of different machines touch.' },
  { title: 'Cross the edge', text: 'Move the pointer across that shared edge. With input permission enabled, your keyboard and mouse control the next machine.' },
  { title: 'Bring a window', text: 'Choose a peer’s window and Bring here. Use the app on this screen while it keeps running on its source machine.' },
];
---

<section class="crosspane-demo" data-crosspane-demo data-step="0" data-paused="true" aria-label="How Crosspane works">
  <div class="cp-demo-bar"><span>Crosspane in action</span><span>Actual interface · Demo machines</span></div>
  <div class="cp-stage" id="crosspane-demo-stage">
    <div class="cp-screen">
      <img class="cp-settings" src="/projects/crosspane-settings.webp" width="2200" height="1520" alt="Crosspane Layout settings with a desktop and MacBook displays arranged on the shared desk canvas." fetchpriority="high" />
      <img class="cp-windows" src="/projects/crosspane-windows.webp" width="2200" height="1520" alt="Crosspane Windows settings, with windows from the demo desktop and MacBook and the Bring here action." loading="lazy" />
      <span class="cp-touch" aria-hidden="true"></span>
      <span class="cp-pointer" aria-hidden="true"><svg viewBox="0 0 24 30" fill="none"><path d="M3 2v22l6-6 5 10 4-2-5-10h9L3 2Z" fill="#e9f8ff" stroke="#071525" stroke-width="2" stroke-linejoin="round" /></svg></span>
      <span class="cp-highlight" aria-hidden="true"></span>
      <span class="cp-image-label">Pointer and transfer overlays are illustrative</span>
    </div>
  </div>
  <div class="cp-flow" aria-label="Illustrated handoff between demo machines">
    <span class="cp-machine cp-source"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M12 18v3m-4 0h8" /></svg><span>desktop</span></span>
    <div class="cp-flow-track"><span class="cp-flow-line" aria-hidden="true"></span><span class="cp-flow-token" data-flow-token>Displays arranged</span></div>
    <span class="cp-machine cp-destination"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M12 18v3m-4 0h8" /></svg><span>macbook</span></span>
  </div>
  <div class="cp-controls" hidden>
    <div class="cp-steps" aria-label="Choose a demonstration step">
      {steps.map((step, i) => <button type="button" data-cp-step={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="crosspane-demo-stage"><span aria-hidden="true">0{i + 1}</span>{step.title}</button>)}
    </div>
    <button class="cp-play" type="button" data-cp-play aria-label="Play automatic demonstration"><span class="cp-play-icon" set:html={iconSvg('lucide', ICONS.play[1]) ?? ''} /><span class="cp-pause-icon" set:html={iconSvg('lucide', ICONS.pause[1]) ?? ''} /><span data-play-label>Play</span></button>
  </div>
  <div class="cp-description">
    <div><h3 data-step-title>{steps[0].title}</h3><p data-step-description>{steps[0].text}</p></div>
    <button class="cp-try" type="button" data-cp-try disabled>Try the handoff <span aria-hidden="true">→</span></button>
  </div>
  <noscript><div class="cp-static-steps">{steps.slice(1).map(step => <p><strong>{step.title}.</strong> {step.text}</p>)}<a href="/projects/crosspane-windows.webp">View the Windows interface <span aria-hidden="true">↗</span></a></div></noscript>
  <div class="cp-caption"><span>Actual Crosspane interface with demo machines.</span><a href="/projects/crosspane-settings.webp" data-cp-full target="_blank" rel="noopener">View full screenshot <span aria-hidden="true">↗</span></a></div>
  <span class="cp-announcement" role="status" aria-live="polite" aria-atomic="true"></span>
</section>

<style>
  .crosspane-demo { --cp-accent: #6fdcff; --cp-pointer-travel: 13; color: #e9f8ff; text-align: left; background: #071525; border: 1px solid #244f6a; border-radius: 1rem; box-shadow: 0 2rem 6rem rgb(0 0 0 / 0.25); overflow: hidden; }
  .cp-demo-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.85rem 1.25rem; border-bottom: 1px solid rgb(111 220 255 / 0.15); font-size: 0.75rem; }
  .cp-demo-bar > span:last-child { color: #89cbd5; font-size: 0.65rem; }
  .cp-stage { overflow: hidden; }
  .cp-screen { position: relative; aspect-ratio: 1100 / 760; overflow: hidden; }
  .cp-screen > img { display: block; width: 100%; height: auto; }
  .cp-windows { display: none !important; }
  [data-step='2'] .cp-settings { display: none; }
  [data-step='2'] .cp-windows { display: block !important; }
  .cp-pointer { position: absolute; z-index: 3; left: 87%; top: 69.3%; width: 1.5rem; height: 1.85rem; filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.4)); opacity: 0; }
  .cp-pointer svg { width: 100%; height: 100%; }
  [data-step='1'] .cp-pointer { opacity: 1; }
  .cp-touch { position: absolute; left: 80.8%; top: 65%; width: 2px; height: 9.1%; background: var(--cp-accent); box-shadow: 0 0 0.9rem rgb(111 220 255 / 0.5); opacity: 0; }
  [data-step='0'] .cp-touch, [data-step='1'] .cp-touch { opacity: 1; }
  .cp-highlight { position: absolute; left: 42.8%; width: 8.4%; top: 80.7%; height: 4.7%; border: 2px solid var(--cp-accent); border-radius: 0.6rem; box-shadow: 0 0 1.5rem rgb(111 220 255 / 0.12); opacity: 0; pointer-events: none; }
  [data-step='2'] .cp-highlight { opacity: 1; }
  .cp-image-label { position: absolute; right: 1rem; bottom: 0.7rem; color: #89cbd5; font-size: 0.55rem; background: rgb(7 21 37 / 0.85); padding: 0.3rem 0.5rem; border-radius: 0.25rem; }
  .cp-flow { display: grid; grid-template-columns: minmax(4.5rem, 1fr) minmax(0, 3fr) minmax(4.5rem, 1fr); align-items: center; gap: 1rem; padding: 1.25rem 2rem; border-top: 1px solid rgb(111 220 255 / 0.15); border-bottom: 1px solid rgb(111 220 255 / 0.15); background: #0a1e30; }
  .cp-machine { display: flex; align-items: center; justify-content: center; gap: 0.65rem; color: #89cbd5; font-size: 0.75rem; }
  .cp-machine svg { width: 1.5rem; height: 1.5rem; flex: none; }
  .cp-destination { color: #b7efff; }
  .cp-flow-track { position: relative; display: flex; align-items: center; justify-content: center; min-height: 2.25rem; }
  .cp-flow-line { position: absolute; inset: 50% 0 auto; border-top: 1px solid rgb(111 220 255 / 0.3); }
  .cp-flow-token { position: relative; padding: 0.6rem 0.8rem; border: 1px solid #32768b; border-radius: 0.45rem; background: #10344d; color: #e9f8ff; font-size: 0.7rem; line-height: 1.2; text-align: center; }
  [data-step='1'] .cp-flow-token { margin-left: auto; }
  [data-step='2'] .cp-flow-token { margin-right: auto; }
  .cp-controls { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem 0; }
  .cp-controls[hidden] { display: none; }
  .cp-steps { display: flex; flex: 1; gap: 0.5rem; }
  .cp-steps button { display: flex; align-items: center; gap: 0.6rem; flex: 1; padding: 0.7rem 0.5rem; border-bottom: 2px solid #244f6a; color: #89cbd5; text-align: left; font-size: 0.75rem; cursor: pointer; }
  .cp-steps button > span { font-size: 0.6rem; color: #6896aa; }
  .cp-steps button[aria-pressed='true'] { border-color: var(--cp-accent); color: #e9f8ff; }
  .cp-steps button[aria-pressed='true'] > span { color: var(--cp-accent); }
  .cp-play { display: flex; align-items: center; justify-content: center; gap: 0.4rem; width: 4.75rem; flex: none; padding: 0.7rem 0.4rem; border: 1px solid #244f6a; border-radius: 0.5rem; color: #b7efff; font-size: 0.7rem; cursor: pointer; }
  .cp-play-icon, .cp-pause-icon { display: inline-flex; width: 0.9rem; height: 0.9rem; }
  .cp-play-icon :global(svg), .cp-pause-icon :global(svg) { width: 100%; height: 100%; }
  [data-paused='true'] .cp-pause-icon, [data-paused='false'] .cp-play-icon { display: none; }
  .cp-description { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.25rem 1.75rem; min-height: 125px; }
  .cp-description h3 { margin: 0 0 0.4rem; font-size: 1.05rem; font-weight: 500; }
  .cp-description p { margin: 0; max-width: 44rem; color: #b7d7df; font-size: 0.85rem; line-height: 1.6; }
  .cp-try { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex: none; padding: 0.8rem 1rem; border: 1px solid #32768b; border-radius: 0.5rem; background: #10344d; color: #e9f8ff; font-size: 0.75rem; cursor: pointer; }
  .cp-try:disabled { display: none; }
  .cp-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding: 0 1.75rem 1.25rem; color: #89cbd5; font-size: 0.65rem; line-height: 1.5; }
  .cp-caption a, .cp-static-steps a { color: #b7efff; text-decoration: underline; text-underline-offset: 3px; }
  .cp-static-steps { display: grid; gap: 0.75rem; padding: 0 1.75rem 1rem; font-size: 0.85rem; line-height: 1.6; color: #b7d7df; }
  .cp-static-steps p { margin: 0; }
  .cp-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .crosspane-demo button:focus-visible, .crosspane-demo a:focus-visible { outline: 2px solid var(--cp-accent); outline-offset: 4px; border-radius: 0.25rem; }
  @media (max-width: 700px) {
    .crosspane-demo { --cp-pointer-travel: 44; }
    .cp-demo-bar { padding: 0.75rem 1rem; font-size: 0.7rem; }
    .cp-demo-bar > span:last-child { max-width: 7rem; text-align: right; font-size: 0.6rem; }
    .cp-screen { aspect-ratio: 1.35 / 1; }
    .cp-screen > img { position: absolute; width: 333%; max-width: none; left: -210%; top: 0; transform: translateY(-57%); }
    .cp-screen > .cp-windows { left: -78%; transform: translateY(-70%); }
    .cp-pointer { left: 79.7%; top: 38.2%; }
    .cp-touch { left: 59.1%; top: 24.8%; height: 28.3%; }
    .cp-highlight { left: 64.5%; width: 28%; top: 33.2%; height: 16%; }
    .cp-image-label { right: 0.5rem; bottom: 0.5rem; font-size: 0.5rem; }
    .cp-flow { grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem; gap: 0.5rem; padding: 1rem; }
    .cp-machine { flex-direction: column; gap: 0.3rem; font-size: 0.65rem; }
    .cp-flow-token { font-size: 0.65rem; padding: 0.55rem 0.6rem; }
    .cp-controls { gap: 0.75rem; padding: 0.75rem 1rem 0; align-items: start; }
    .cp-steps { flex-direction: column; gap: 0; }
    .cp-steps button { padding: 0.55rem 0.25rem; border-bottom-width: 1px; font-size: 0.73rem; }
    .cp-play { margin-top: 0.25rem; }
    .cp-description { flex-direction: column; align-items: start; gap: 1rem; padding: 1rem; min-height: 190px; }
    .cp-caption { padding: 0 1rem 1rem; }
    .cp-static-steps { padding-inline: 1rem; }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-crosspane-demo]');
  if (demo) {
    const steps = [
      ['Arrange displays', 'Place each machine where it sits on your desk. Apply the layout. The pointer crosses where displays of different machines touch.'],
      ['Cross the edge', 'Move the pointer across that shared edge. With input permission enabled, your keyboard and mouse control the next machine.'],
      ['Bring a window', 'Choose a peer’s window and Bring here. Use the app on this screen while it keeps running on its source machine.'],
    ];
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-cp-step]'));
    const play = demo.querySelector<HTMLButtonElement>('[data-cp-play]')!;
    const tryButton = demo.querySelector<HTMLButtonElement>('[data-cp-try]')!;
    const pointer = demo.querySelector<HTMLElement>('.cp-pointer')!;
    const token = demo.querySelector<HTMLElement>('.cp-flow-token')!;
    const highlight = demo.querySelector<HTMLElement>('.cp-highlight')!;
    const announcement = demo.querySelector<HTMLElement>('.cp-announcement')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let step = 0;
    let paused = reduced.matches;
    let visible = false;
    let entered = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    let animations: Animation[] = [];
    const illustrate = () => {
      animations.forEach(animation => animation.cancel());
      animations = [];
      if (reduced.matches) return;
      if (step === 0) animations.push(demo.querySelector('.cp-touch')!.animate([{ opacity: 0.2 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' }));
      if (step === 1) {
        const screen = demo.querySelector<HTMLElement>('.cp-screen')!;
        const travel = Number(getComputedStyle(demo).getPropertyValue('--cp-pointer-travel')) / 100;
        animations.push(pointer.animate([{ transform: `translateX(${-screen.clientWidth * travel}px)` }, { transform: 'translateX(0)' }], { duration: 1600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }));
        animations.push(token.animate([{ transform: `translateX(${-(token.parentElement!.clientWidth - token.clientWidth)}px)`, opacity: 0.5 }, { transform: 'translateX(0)', opacity: 1 }], { duration: 1600, easing: 'ease-in-out' }));
      }
      if (step === 2) {
        animations.push(highlight.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 550 }));
        animations.push(token.animate([{ transform: `translateX(${token.parentElement!.clientWidth - token.clientWidth}px)`, opacity: 0.2 }, { transform: 'translateX(0)', opacity: 1 }], { duration: 1600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }));
      }
    };
    const show = (next: number, manual = false) => {
      step = next;
      demo.dataset.step = String(step);
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === step)));
      demo.querySelector('[data-step-title]')!.textContent = steps[step][0];
      demo.querySelector('[data-step-description]')!.textContent = steps[step][1];
      token.textContent = step === 2 ? 'Safari · Design references' : step === 1 ? 'Keyboard + mouse follow' : 'Displays arranged';
      tryButton.textContent = step === 2 ? 'Replay window example ↻' : step === 1 ? 'Bring a window →' : 'Try the handoff →';
      demo.querySelector<HTMLAnchorElement>('[data-cp-full]')!.href = step === 2 ? '/projects/crosspane-windows.webp' : '/projects/crosspane-settings.webp';
      if (manual) announcement.textContent = `${steps[step][0]}. ${steps[step][1]}`;
      illustrate();
    };
    const sync = () => {
      clearInterval(timer);
      const playing = !paused && visible && !document.hidden;
      demo.dataset.paused = String(paused);
      demo.dataset.playing = String(playing);
      play.setAttribute('aria-label', paused ? 'Play automatic demonstration' : 'Pause automatic demonstration');
      play.querySelector('[data-play-label]')!.textContent = paused ? 'Play' : 'Pause';
      animations.forEach(animation => { if (!visible || document.hidden || paused) animation.pause(); else animation.play(); });
      if (playing) timer = setInterval(() => show((step + 1) % steps.length), 6500);
    };
    buttons.forEach((button, i) => button.addEventListener('click', () => { paused = true; show(i, true); sync(); if (!reduced.matches) animations.forEach(animation => animation.play()); }));
    tryButton.addEventListener('click', () => { paused = true; show(Math.min(step + 1, 2), true); sync(); if (!reduced.matches) animations.forEach(animation => animation.play()); });
    play.addEventListener('click', () => { paused = !paused; sync(); });
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting && entries[0].intersectionRatio >= 0.25; if (visible && !entered) { entered = true; illustrate(); } sync(); }, { threshold: 0.25 });
    observer.observe(demo);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', () => { paused = reduced.matches; show(step); sync(); });
    window.addEventListener('pagehide', () => { clearInterval(timer); animations.forEach(animation => animation.pause()); observer.disconnect(); });
    window.addEventListener('pageshow', () => { observer.observe(demo); sync(); });
    tryButton.disabled = false;
    demo.querySelector<HTMLElement>('.cp-controls')!.hidden = false;
    sync();
  }
</script>
