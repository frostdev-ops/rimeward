---
import Icon from '../Icon.astro';
import { ICONS, type IconId } from '../../lib/icon-names.ts';
import { iconSvg } from '../../lib/icons.ts';

const svg = (id: IconId) => iconSvg('lucide', ICONS[id][1], '', 1.75) ?? '';

const steps = [
  { title: 'Add wards', text: 'A ward is a tool card. Arrange your notes, editor, browser and Rime on a page that fits your work.' },
  { title: 'Connect with Leylines', text: 'Choose a trigger and an action. Here, pressing a Button ward asks Rime a question you set.' },
  { title: 'Work with Rime', text: 'Ask Rime to help with the work in front of you, using the tools and permissions you provide.' },
];
---

<section class="ward-demo" data-ward-demo data-step="0" data-playing="false" aria-label="How wards work">
  <div class="demo-bar">
    <span><span class="demo-icon" set:html={svg('columns')} /> Your workspace</span>
    <div class="demo-mode" aria-hidden="true"><span data-mode>Wards</span><i></i> Orbital</div>
  </div>
  <div class="demo-stage" id="ward-demo-stage">
    <article class="demo-ward demo-editor">
      <header><span><span class="demo-icon" set:html={svg('code')} /> Editor</span><span class="demo-icon" set:html={svg('resize')} /></header>
      <div class="demo-shot editor-shot"><img src="/projects/rimeward-editor.webp" width="1248" height="660" alt="Rimeward Editor showing the Orbital project files and TypeScript workspace." loading="lazy" /></div>
    </article>
    <article class="demo-ward demo-rime">
      <header><span><Icon id="rime" /> Rime</span><span class="demo-state" data-rime-status>Ready</span></header>
      <div class="rime-idle">
        <span class="rime-idle-mark" aria-hidden="true"><Icon id="rime" /></span>
        <h3>Your tools.<br />A little help.</h3>
        <p>Talk to Rime here, or connect a Leyline to ask a question.</p>
      </div>
      <div class="demo-shot rime-shot"><picture><source media="(max-width: 900px)" srcset="/projects/rimeward-reply-phone.webp" width="346" height="343" /><img src="/projects/rimeward-chat.webp" width="1088" height="900" alt="Example Rime response suggesting a workspace overview, project files and one useful action." loading="lazy" /></picture></div>
      <div class="rime-composer" aria-hidden="true">Message Rime… <span class="demo-icon" set:html={svg('send')} /></div>
    </article>
    <article class="demo-ward demo-notes">
      <header><span><span class="demo-icon" set:html={svg('note')} /> Notes</span><span class="demo-icon" set:html={svg('resize')} /></header>
      <div class="demo-shot notes-shot"><img src="/projects/rimeward-notes.webp" width="1248" height="772" alt="Rimeward notes with the Orbital project’s design direction and focus for today." loading="lazy" /></div>
    </article>
    <article class="demo-ward demo-browser">
      <header><span><span class="demo-icon" set:html={svg('globe')} /> Browser</span><span class="demo-icon" set:html={svg('resize')} /></header>
      <div class="demo-shot browser-shot"><img src="/projects/rimeward-workspace.webp" width="1360" height="900" alt="Rimeward Browser showing a sample Fieldnotes design journal." loading="lazy" /></div>
    </article>
    <article class="demo-ward demo-button">
      <header><span><span class="demo-icon" set:html={svg('button')} /> Button</span><span class="demo-port" aria-hidden="true"></span></header>
      <button class="demo-trigger" type="button" data-demo-trigger disabled aria-label="Run the local Ask Rime example"><span class="demo-icon" set:html={svg('button')} /><strong>Plan Orbital’s next step</strong><span data-button-status>A question, one tap away</span></button>
    </article>
    <svg class="demo-wire" viewBox="0 0 1000 530" preserveAspectRatio="none" aria-hidden="true">
      <path class="wire-track" d="M875 430 C950 430 978 400 978 320 L978 88 C978 64 956 64 928 64" />
      <path class="wire-signal" d="M875 430 C950 430 978 400 978 320 L978 88 C978 64 956 64 928 64" />
      <circle cx="875" cy="430" r="5" /><circle cx="928" cy="64" r="5" />
    </svg>
    <div class="demo-rule" aria-hidden="true"><span class="demo-icon" set:html={svg('button')} /><span>Button pressed</span><span class="rule-arrow">→</span><Icon id="rime" /><span>Ask Rime</span></div>
  </div>

  <div class="demo-controls" hidden>
    <div class="demo-steps" aria-label="Choose a demonstration step">
      {steps.map((step, i) => (
        <button type="button" data-demo-step={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="ward-demo-stage"><span aria-hidden="true">0{i + 1}</span>{step.title}</button>
      ))}
    </div>
    <button class="demo-play" type="button" data-demo-play aria-label="Pause demonstration"><span class="play-icon demo-icon" set:html={svg('play')} /><span class="pause-icon demo-icon" set:html={svg('pause')} /><span data-play-label>Pause</span></button>
  </div>
  <div class="demo-explanation" data-demo-description>
    <h3>{steps[0].title}</h3><p>{steps[0].text}</p>
  </div>
  <noscript>
    <div class="demo-static-steps">{steps.slice(1).map(step => <p><strong>{step.title}.</strong> {step.text}</p>)}</div>
  </noscript>
  <p class="demo-caption">Illustrative animation using real Rimeward UI with sample content. No live request. This example needs a configured Leyline and Rime model access in the app.</p>
  <span class="demo-announcement" role="status" aria-live="polite" aria-atomic="true"></span>
</section>

<style>
  .ward-demo { --demo-accent: #6fdcff; --color-surface: #0d1b2e; --color-surface-2: #060d18; --color-ink: #e8f2fa; --color-ink-muted: #8fa8c0; --color-line: #16283f; color: var(--color-ink); border: 1px solid #24405f; border-radius: 1rem; background: var(--color-surface-2); box-shadow: 0 2rem 6rem rgb(0 0 0 / 0.25); overflow: hidden; text-align: left; }
  .demo-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-line); font-size: 0.8rem; }
  .demo-bar > span, .demo-mode, .demo-ward header > span:first-child { display: flex; align-items: center; gap: 0.55rem; }
  .demo-mode { color: var(--color-ink-muted); font-size: 0.7rem; }
  .demo-mode i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
  .ward-demo :global(.fd-ic), .ward-demo :global(.fd-ic-img), .ward-demo :global(.fd-ic-e) { width: 1rem; height: 1rem; flex: none; }
  .demo-icon { display: inline-flex; width: 1rem; height: 1rem; flex: none; }
  .demo-icon :global(svg) { width: 100%; height: 100%; }
  .demo-stage { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: 300px 174px; gap: 0.75rem; padding: 1rem 1rem 3.5rem; }
  .demo-ward { position: relative; min-width: 0; overflow: hidden; border: 1px solid var(--color-line); border-radius: 0.6rem; background: var(--color-surface); }
  .demo-ward header { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; height: 38px; padding: 0 0.75rem; background: var(--color-surface); color: var(--color-ink-muted); font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }
  .demo-ward header > .demo-icon { width: 0.75rem; height: 0.75rem; color: #5c7189; }
  .demo-editor { grid-column: span 3; }
  .demo-notes { grid-column: span 2; }
  .demo-shot { position: relative; height: calc(100% - 38px); overflow: hidden; }
  .demo-shot img { position: absolute; max-width: none; height: auto; }
  .editor-shot img { width: 151%; top: 0; left: 0; transform: translateY(-7.2%); }
  .notes-shot img { width: 151%; top: 0; left: 0; transform: translateY(-11%); }
  .browser-shot img { width: 200%; top: 0; left: 0; transform: translateY(-10.5%); }
  .rime-shot { display: none; }
  .rime-shot img { width: 148%; left: -24%; top: 0; transform: translateY(-39%); }
  .rime-idle { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.65rem; height: 210px; padding: 0.8rem; text-align: center; }
  .rime-idle-mark :global(.fd-ic) { width: 2.5rem; height: 2.5rem; color: var(--demo-accent); opacity: 0.8; }
  .rime-idle h3 { margin: 0; font-size: 1.2rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.035em; }
  .rime-idle p { margin: 0; max-width: 13rem; color: var(--color-ink-muted); font-size: 0.7rem; line-height: 1.5; }
  .rime-composer { position: absolute; inset: auto 0.6rem 0.6rem; display: flex; align-items: center; justify-content: space-between; gap: 0.3rem; height: 34px; padding: 0 0.6rem; border: 1px solid #24405f; border-radius: 0.65rem; color: #8fa8c0; font-size: 0.7rem; background: var(--color-surface); }
  .rime-composer .demo-icon { color: var(--demo-accent); }
  .demo-state { color: #8fa8c0; font-size: 0.55rem; letter-spacing: 0; text-transform: none; }
  .demo-trigger { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.7rem; width: 100%; height: calc(100% - 38px); padding: 0.5rem; text-align: center; cursor: pointer; }
  .demo-trigger:disabled { cursor: default; }
  .demo-trigger:hover:not(:disabled) { background: #082f49; }
  .demo-trigger .demo-icon { width: 1.5rem; height: 1.5rem; color: var(--demo-accent); }
  .demo-trigger strong { font-size: 0.78rem; font-weight: 500; }
  .demo-trigger > span:last-child { color: var(--color-ink-muted); font-size: 0.6rem; }
  .demo-port { width: 0.45rem; height: 0.45rem; border: 1px solid #5c7189; border-radius: 50%; }
  .demo-wire { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; pointer-events: none; opacity: 0; }
  .demo-wire path { fill: none; stroke: var(--demo-accent); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .wire-track { opacity: 0.35; }
  .wire-signal { stroke-dasharray: 8 18; animation: demo-signal 2s linear infinite; animation-play-state: paused; }
  .demo-wire circle { fill: var(--demo-accent); }
  .demo-rule { position: absolute; z-index: 4; left: 50%; bottom: 0.5rem; transform: translateX(-50%); display: flex; align-items: center; gap: 0.55rem; padding: 0.6rem 0.8rem; border: 1px solid #32768b; border-radius: 0.55rem; background: #082f49; color: #e8f2fa; font-size: 0.72rem; white-space: nowrap; visibility: hidden; }
  .demo-rule :global(.fd-ic) { color: var(--demo-accent); }
  .rule-arrow { color: var(--demo-accent); }
  [data-step='1'] .demo-wire, [data-step='2'] .demo-wire { opacity: 1; }
  [data-step='1'] .demo-rule, [data-step='2'] .demo-rule { visibility: visible; }
  [data-step='1'] .demo-button, [data-step='1'] .demo-rime, [data-step='2'] .demo-rime { border-color: #32768b; }
  [data-step='2'][data-replied='true'] .rime-idle { display: none; }
  [data-step='2'][data-replied='true'] .rime-shot { display: block; height: 210px; }
  [data-step='2'] .demo-trigger { background: #082f49; }
  [data-step='2'] .demo-state { color: var(--demo-accent); }
  [data-step='2'] .demo-editor, [data-step='2'] .demo-rime { grid-column: span 2; }
  [data-request='true'][data-visible='true'] .wire-signal { animation-play-state: running; }
  .demo-controls { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem 0; }
  .demo-controls[hidden] { display: none; }
  .demo-steps { display: flex; flex: 1; gap: 0.5rem; }
  .demo-steps button { display: flex; align-items: center; gap: 0.6rem; flex: 1; padding: 0.7rem 0.5rem; border-bottom: 2px solid #24405f; color: #8fa8c0; text-align: left; font-size: 0.75rem; cursor: pointer; }
  .demo-steps button > span { font-size: 0.6rem; color: #5c7189; }
  .demo-steps button[aria-pressed='true'] { border-color: var(--demo-accent); color: #e8f2fa; }
  .demo-steps button[aria-pressed='true'] > span { color: var(--demo-accent); }
  .demo-play { display: flex; align-items: center; justify-content: center; gap: 0.4rem; width: 4.75rem; flex: none; padding: 0.7rem 0.4rem; border: 1px solid #24405f; border-radius: 0.5rem; color: #b3c8dc; font-size: 0.7rem; cursor: pointer; }
  .play-icon { display: none; }
  [data-playing='false'] .pause-icon { display: none; }
  [data-playing='false'] .play-icon { display: inline-flex; }
  .demo-explanation { padding: 1.25rem 1.75rem 0.5rem; min-height: 100px; }
  .demo-explanation h3 { margin: 0 0 0.4rem; font-size: 1.05rem; font-weight: 500; }
  .demo-explanation p, .demo-static-steps p { margin: 0; color: #b3c8dc; font-size: 0.85rem; line-height: 1.6; }
  .demo-static-steps { display: grid; gap: 0.75rem; padding: 0 1.75rem 1rem; }
  .demo-caption { margin: 0; padding: 0.5rem 1.75rem 1.25rem; color: #8fa8c0; font-size: 0.65rem; line-height: 1.5; }
  .demo-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .ward-demo button:focus-visible { outline: 2px solid var(--demo-accent); outline-offset: 4px; border-radius: 0.25rem; }
  @keyframes demo-signal { to { stroke-dashoffset: -52; } }
  @media (max-width: 900px) {
    .demo-stage { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 210px 190px 126px; gap: 0.5rem; padding: 0.75rem 0.75rem 3rem; }
    .demo-editor { grid-column: span 2; }
    .demo-rime { grid-column: 2; grid-row: 2 / span 2; }
    .demo-notes { grid-column: 1; grid-row: 2; }
    .demo-browser { display: none; }
    .demo-button { grid-column: 1; grid-row: 3; }
    .rime-idle { height: 245px; padding: 0.6rem; }
    .rime-idle h3 { font-size: 1.1rem; }
    [data-step='2'] .demo-stage { grid-template-rows: 420px 90px; }
    [data-step='2'] .demo-rime { grid-column: 1 / -1; grid-row: 1; }
    [data-step='2'] .demo-editor, [data-step='2'] .demo-notes { display: none; }
    [data-step='2'] .demo-button { grid-column: 1 / -1; grid-row: 2; }
    [data-step='2'][data-replied='true'] .rime-shot { height: 343px; }
    .rime-shot img { width: 100%; max-width: 346px; left: 50%; transform: translateX(-50%); }
    [data-step='2'] .rime-idle { height: 345px; }
    [data-step='2'] .demo-trigger { gap: 0.3rem; }
    [data-step='2'] .demo-trigger > .demo-icon { display: none; }
    .demo-rule { font-size: 0.6rem; gap: 0.35rem; }
    .demo-rule :global(.fd-ic) { width: 0.8rem; height: 0.8rem; }
    .demo-controls { gap: 0.75rem; padding: 0.75rem 0.75rem 0; align-items: start; }
    .demo-steps { flex-direction: column; gap: 0; }
    .demo-steps button { padding: 0.55rem 0.25rem; border-bottom-width: 1px; font-size: 0.73rem; }
    .demo-play { margin-top: 0.25rem; }
    .demo-explanation { padding: 1rem 1rem 0.5rem; min-height: 115px; }
    .demo-caption { padding: 0.5rem 1rem 1rem; }
    .demo-static-steps { padding-inline: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .wire-signal { animation: none; } }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-ward-demo]');
  if (demo) {
    const steps = [
      ['Add wards', 'A ward is a tool card. Arrange your notes, editor, browser and Rime on a page that fits your work.'],
      ['Connect with Leylines', 'Choose a trigger and an action. Here, pressing a Button ward asks Rime a question you set.'],
      ['Work with Rime', 'Ask Rime to help with the work in front of you, using the tools and permissions you provide.'],
    ];
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-step]'));
    const play = demo.querySelector<HTMLButtonElement>('[data-demo-play]')!;
    const trigger = demo.querySelector<HTMLButtonElement>('[data-demo-trigger]')!;
    const description = demo.querySelector<HTMLElement>('[data-demo-description]')!;
    const announcement = demo.querySelector<HTMLElement>('.demo-announcement')!;
    const wards = Array.from(demo.querySelectorAll<HTMLElement>('.demo-ward'));
    const stage = demo.querySelector<HTMLElement>('.demo-stage')!;
    const source = demo.querySelector<HTMLElement>('.demo-button')!;
    const target = demo.querySelector<HTMLElement>('.demo-rime')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let step = 0;
    let paused = reduced.matches;
    let visible = false;
    let entered = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    let replyTimer: ReturnType<typeof setTimeout> | undefined;
    const wire = () => {
      const narrow = matchMedia('(max-width: 900px)').matches && step !== 2;
      const sx = (source.offsetLeft + source.offsetWidth) / stage.clientWidth * 1000;
      const sy = (source.offsetTop + 19) / stage.clientHeight * 530;
      const ex = (target.offsetLeft + (narrow ? 0 : target.offsetWidth)) / stage.clientWidth * 1000;
      const ey = (target.offsetTop + 19) / stage.clientHeight * 530;
      const gutter = narrow ? (sx + ex) / 2 : (stage.clientWidth - 5) / stage.clientWidth * 1000;
      const path = `M${sx} ${sy} C${gutter} ${sy} ${gutter} ${sy} ${gutter} ${sy - 12} L${gutter} ${ey + 12} Q${gutter} ${ey} ${ex} ${ey}`;
      demo.querySelectorAll('.demo-wire path').forEach(line => line.setAttribute('d', path));
      demo.querySelectorAll('.demo-wire circle').forEach((circle, i) => {
        circle.setAttribute('cx', String(i ? ex : sx));
        circle.setAttribute('cy', String(i ? ey : sy));
      });
    };
    const entrance = () => {
      if (reduced.matches) return;
      wards.forEach((ward, i) => {
        ward.getAnimations().forEach(animation => animation.cancel());
        ward.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 550, delay: i * 75, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
      });
    };
    const request = (manual: boolean) => {
      demo.dataset.replied = 'false';
      demo.dataset.request = 'true';
      demo.querySelector('[data-rime-status]')!.textContent = 'Example request';
      demo.querySelector('[data-button-status]')!.textContent = 'Sending example…';
      if (manual) announcement.textContent = 'Example request sent along the Leyline to Rime.';
      const reply = () => {
        demo.dataset.replied = 'true';
        demo.dataset.request = 'false';
        demo.querySelector('[data-rime-status]')!.textContent = 'Example reply';
        demo.querySelector('[data-button-status]')!.textContent = 'Replay the example';
        if (manual) announcement.textContent = 'Example response ready in the Rime ward.';
        if (!reduced.matches) demo.querySelector('.demo-rime')!.animate([{ boxShadow: '0 0 0 1px #6fdcff' }, { boxShadow: '0 0 0 1px transparent' }], { duration: 650 });
      };
      if (reduced.matches) reply();
      else replyTimer = setTimeout(reply, 900);
    };
    const show = (next: number, manual = false) => {
      wards.forEach(ward => ward.getAnimations().forEach(animation => animation.cancel()));
      const before = wards.map(ward => ward.getBoundingClientRect());
      clearTimeout(replyTimer);
      demo.dataset.replied = 'false';
      demo.dataset.request = 'false';
      step = next;
      demo.dataset.step = String(step);
      wire();
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === step)));
      description.querySelector('h3')!.textContent = steps[step][0];
      description.querySelector('p')!.textContent = steps[step][1];
      demo.querySelector('[data-mode]')!.textContent = step === 1 ? 'Leylines' : 'Wards';
      demo.querySelector('[data-rime-status]')!.textContent = step === 2 ? 'Example reply' : step === 1 ? 'Connected' : 'Ready';
      demo.querySelector('[data-button-status]')!.textContent = step === 2 ? 'Illustrated request sent' : step === 1 ? 'Button pressed → Ask Rime' : 'A question, one tap away';
      if (manual && step !== 2) announcement.textContent = `${steps[step][0]}. ${steps[step][1]}`;
      if (step === 2) request(manual);
      if (!reduced.matches) {
        wards.forEach((ward, i) => {
          const after = ward.getBoundingClientRect();
          if (!before[i].width || !after.width) return;
          ward.animate([
            { transform: `translate(${before[i].x - after.x}px, ${before[i].y - after.y}px) scale(${before[i].width / after.width}, ${before[i].height / after.height})`, transformOrigin: 'top left' },
            { transform: 'translate(0, 0) scale(1, 1)', transformOrigin: 'top left' },
          ], { duration: 550, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
        });
        if (step === 0) entrance();
        description.getAnimations().forEach(animation => animation.cancel());
        description.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 350, easing: 'ease-out' });
      }
    };
    const sync = () => {
      clearInterval(timer);
      const playing = !paused && visible && !document.hidden;
      demo.dataset.visible = String(visible && !document.hidden);
      demo.dataset.playing = String(playing);
      play.setAttribute('aria-label', paused ? 'Play demonstration' : 'Pause demonstration');
      play.querySelector('[data-play-label]')!.textContent = paused ? 'Play' : 'Pause';
      if (playing) timer = setInterval(() => show((step + 1) % steps.length), 6500);
    };
    buttons.forEach((button, i) => button.addEventListener('click', () => { paused = true; show(i, true); sync(); }));
    play.addEventListener('click', () => { paused = !paused; sync(); });
    trigger.addEventListener('click', () => { paused = true; show(2, true); sync(); });
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting && entries[0].intersectionRatio >= 0.25;
      if (visible && !entered) { entered = true; entrance(); }
      sync();
    }, { threshold: 0.25 });
    observer.observe(demo);
    const resize = new ResizeObserver(wire);
    resize.observe(stage);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', () => { paused = reduced.matches; sync(); });
    window.addEventListener('pagehide', () => { clearInterval(timer); clearTimeout(replyTimer); observer.disconnect(); resize.disconnect(); });
    window.addEventListener('pageshow', () => { observer.observe(demo); resize.observe(stage); wire(); sync(); });
    trigger.disabled = false;
    demo.querySelector<HTMLElement>('.demo-controls')!.hidden = false;
    sync();
  }
</script>
