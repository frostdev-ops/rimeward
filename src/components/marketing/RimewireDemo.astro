---
import { ICONS, type IconId } from '../../lib/icon-names.ts';
import { iconSvg } from '../../lib/icons.ts';

const svg = (id: IconId) => iconSvg('lucide', ICONS[id][1], '', 1.75) ?? '';
const steps = [
  {
    id: 'plan', title: 'Start with a plan', label: 'Read the project · MCP', phoneHeight: 430,
    text: 'Your tracker becomes work packages, dependencies, and a shared view of what comes next.',
    command: 'board_overview',
    alt: 'Actual Rimewire board with three planned packages for a demonstration website refresh.',
  },
  {
    id: 'progress', title: 'See the work move', label: 'Post an update · CLI', phoneHeight: 546,
    text: 'An agent reports 70% progress. Another flags a missing release URL. The board keeps both in view.',
    command: 'rimewire progress SITE-1 --percent 70 \\\n  --text "Layouts in place. Checking narrow screens."\n\nrimewire blocker SITE-2 \\\n  --text "Waiting for the approved release URL."',
    alt: 'Actual Rimewire board showing SITE-1 at 70 percent and SITE-2 blocked by a missing release URL.',
  },
  {
    id: 'ready', title: 'Hand off with evidence', label: 'Mark readiness · CLI', phoneHeight: 404,
    text: 'The work is checked, the blocker is resolved, and agents post explicit ready updates with a review handoff.',
    command: 'rimewire ready SITE-3 \\\n  --text "Final review complete. Handoff: project pages and source links checked."',
    alt: 'Actual Rimewire board with explicit ready updates and a review handoff for all three demonstration packages.',
  },
];
---

<section class="rimewire-demo" data-rimewire-demo data-step="0" data-playing="false" aria-label="Follow a project in Rimewire">
  <header class="demo-topline">
    <span><span class="demo-icon" set:html={svg('folders')} /> Website refresh</span>
    <span class="demo-badge">Actual board · Demo project</span>
  </header>
  <div class="demo-screens" id="rimewire-demo-screen">
    {steps.map((step, index) => (
      <figure class="demo-slide" data-demo-slide={index} data-active={index === 0 ? 'true' : 'false'} aria-hidden={index === 0 ? 'false' : 'true'}>
        <picture>
          <source media="(max-width: 700px)" srcset={`/projects/rimewire-board-${step.id}-phone.webp`} width="358" height={step.phoneHeight} />
          <img src={`/projects/rimewire-board-${step.id}.webp`} width="1280" height="720" alt={step.alt} loading={index === 0 ? 'eager' : 'lazy'} />
        </picture>
      </figure>
    ))}
  </div>
  <div class="demo-update">
    <div class="update-caption"><span class="demo-icon" set:html={svg('code')} /><span data-update-label>{steps[0].label}</span><span class="update-path" aria-hidden="true">Tracker + updates → Board</span></div>
    <pre><code data-update-command>{steps[0].command}</code></pre>
  </div>
  <div class="demo-controls" hidden>
    <div class="demo-steps" aria-label="Choose a Rimewire demonstration step">
      {steps.map((step, index) => <button type="button" data-demo-step={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="rimewire-demo-screen"><span aria-hidden="true">0{index + 1}</span>{step.title}</button>)}
    </div>
    <button class="demo-play" type="button" data-demo-play aria-label="Pause Rimewire demonstration"><span class="demo-icon play-icon" set:html={svg('play')} /><span class="demo-icon pause-icon" set:html={svg('pause')} /><span data-play-label>Pause</span></button>
  </div>
  <div class="demo-explanation" data-demo-description><h3>{steps[0].title}</h3><p>{steps[0].text}</p></div>
  <noscript><ol class="demo-static-steps">{steps.slice(1).map(step => <li><strong>{step.title}.</strong> {step.text}</li>)}</ol></noscript>
  <div class="demo-caption"><p>Real Rimewire board with demo data. Ready records checked work and a review handoff.</p><a data-demo-fullsize href="/projects/rimewire-board-plan.webp" target="_blank" rel="noopener noreferrer" aria-label="View the plan demo board at full size (opens a new tab)">View full-size board <span aria-hidden="true">↗</span></a></div>
  <span class="demo-announcement" role="status" aria-live="polite" aria-atomic="true"></span>
</section>

<style>
  .rimewire-demo { min-width: 0; width: 100%; border: 1px solid #2b455d; border-radius: 1rem; background: #060d18; overflow: hidden; text-align: left; box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.2); }
  .demo-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid #263c51; color: #d5e7f4; font-size: 0.8rem; }
  .demo-topline > span:first-child, .update-caption { display: flex; align-items: center; gap: 0.6rem; }
  .demo-badge { color: #9bb7cb; font-size: 0.68rem; }
  .demo-icon { display: inline-flex; width: 1rem; height: 1rem; flex: none; color: #99dce5; }
  .demo-icon :global(svg) { width: 100%; height: 100%; }
  .demo-screens { display: grid; aspect-ratio: 16 / 9; background: #060d18; }
  .demo-slide { grid-area: 1 / 1; margin: 0; min-width: 0; opacity: 0; visibility: hidden; transition: opacity 350ms ease; }
  .demo-slide[data-active='true'] { opacity: 1; visibility: visible; }
  .demo-slide picture, .demo-slide img { display: block; width: 100%; height: auto; }
  .demo-update { border-top: 1px solid #263c51; border-bottom: 1px solid #263c51; background: #0a1828; padding: 1.1rem 1.5rem; }
  .update-caption { color: #a6c2d6; font-size: 0.7rem; }
  .update-path { margin-left: auto; color: #87a7be; font-size: 0.65rem; }
  pre { min-height: 7.4rem; margin: 0.85rem 0 0; color: #d5eaf2; font: 0.78rem/1.75 ui-monospace, SFMono-Regular, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  .demo-controls { display: flex; align-items: start; gap: 1rem; padding: 1rem 1.25rem 0; }
  .demo-controls[hidden] { display: none; }
  .demo-steps { display: flex; flex: 1; gap: 0.5rem; }
  .demo-steps button { display: flex; align-items: center; flex: 1; gap: 0.6rem; padding: 0.8rem 0.5rem; border-bottom: 2px solid #294358; text-align: left; color: #aac2d4; font-size: 0.75rem; cursor: pointer; }
  .demo-steps button > span { color: #88aabe; font-size: 0.65rem; }
  .demo-steps button[aria-pressed='true'] { color: #e8f5fa; border-color: #99dce5; }
  .demo-steps button[aria-pressed='true'] > span { color: #99dce5; }
  .demo-play { display: flex; justify-content: center; align-items: center; gap: 0.4rem; padding: 0.75rem 0.5rem; min-width: 4.75rem; border: 1px solid #365469; border-radius: 0.5rem; color: #b9d1e1; font-size: 0.7rem; cursor: pointer; }
  .play-icon { display: none; }
  [data-playing='false'] .pause-icon { display: none; }
  [data-playing='false'] .play-icon { display: inline-flex; }
  .demo-explanation { padding: 1.25rem 1.75rem 0.5rem; min-height: 6.7rem; }
  .demo-explanation h3 { color: #e8f2fa; margin: 0 0 0.4rem; font-size: 1.05rem; font-weight: 500; }
  .demo-explanation p, .demo-static-steps { color: #b3c8dc; margin: 0; font-size: 0.85rem; line-height: 1.65; }
  .demo-static-steps { padding: 0 1.75rem 1rem 2.75rem; }
  .demo-static-steps li + li { margin-top: 0.75rem; }
  .demo-caption { display: flex; align-items: start; justify-content: space-between; gap: 1rem; margin: 0; padding: 0.5rem 1.75rem 1.25rem; color: #9bb7cb; font-size: 0.68rem; line-height: 1.6; }
  .demo-caption p { margin: 0; }
  .demo-caption a { color: #bce8ee; flex: none; }
  .demo-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  button:focus-visible { outline: 2px solid #99dce5; outline-offset: 4px; border-radius: 0.25rem; }
  @media (max-width: 700px) {
    .demo-topline { padding: 0.8rem 1rem; align-items: start; flex-direction: column; gap: 0.4rem; }
    .demo-screens { aspect-ratio: 358 / 546; }
    .demo-update { padding: 1rem; }
    .update-path { display: none; }
    pre { font-size: 0.72rem; min-height: 12rem; }
    .demo-controls { gap: 0.6rem; padding: 0.75rem 1rem 0; }
    .demo-steps { flex-direction: column; gap: 0; }
    .demo-steps button { padding: 0.6rem 0; border-bottom-width: 1px; }
    .demo-play { margin-top: 0.25rem; }
    .demo-explanation { min-height: 8.5rem; padding: 1rem 1rem 0.5rem; }
    .demo-caption { flex-direction: column; gap: 0.6rem; padding: 0.5rem 1rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .demo-slide { transition: none; } }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-rimewire-demo]');
  if (demo) {
    const steps = [
      { id: 'plan', title: 'Start with a plan', label: 'Read the project · MCP', text: 'Your tracker becomes work packages, dependencies, and a shared view of what comes next.', command: 'board_overview' },
      { id: 'progress', title: 'See the work move', label: 'Post an update · CLI', text: 'An agent reports 70% progress. Another flags a missing release URL. The board keeps both in view.', command: 'rimewire progress SITE-1 --percent 70 \\\n  --text "Layouts in place. Checking narrow screens."\n\nrimewire blocker SITE-2 \\\n  --text "Waiting for the approved release URL."' },
      { id: 'ready', title: 'Hand off with evidence', label: 'Mark readiness · CLI', text: 'The work is checked, the blocker is resolved, and agents post explicit ready updates with a review handoff.', command: 'rimewire ready SITE-3 \\\n  --text "Final review complete. Handoff: project pages and source links checked."' },
    ];
    const controls = demo.querySelector<HTMLElement>('.demo-controls')!;
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-step]'));
    const slides = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-slide]'));
    const play = demo.querySelector<HTMLButtonElement>('[data-demo-play]')!;
    const description = demo.querySelector<HTMLElement>('[data-demo-description]')!;
    const announcement = demo.querySelector<HTMLElement>('.demo-announcement')!;
    const fullsize = demo.querySelector<HTMLAnchorElement>('[data-demo-fullsize]')!;
    const narrow = matchMedia('(max-width: 700px)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let step = 0;
    let paused = reduced.matches;
    let visible = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    const updateLink = () => {
      fullsize.href = `/projects/rimewire-board-${steps[step].id}${narrow.matches ? '-phone' : ''}.webp`;
      fullsize.setAttribute('aria-label', `View the ${steps[step].id} demo board at full size (opens a new tab)`);
    };
    const show = (next: number, manual = false) => {
      step = next;
      demo.dataset.step = String(step);
      buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === step)));
      slides.forEach((slide, index) => {
        slide.dataset.active = String(index === step);
        slide.setAttribute('aria-hidden', String(index !== step));
      });
      description.querySelector('h3')!.textContent = steps[step].title;
      description.querySelector('p')!.textContent = steps[step].text;
      demo.querySelector('[data-update-label]')!.textContent = steps[step].label;
      demo.querySelector('[data-update-command]')!.textContent = steps[step].command;
      updateLink();
      if (manual) announcement.textContent = `${steps[step].title}. ${steps[step].text}`;
    };
    const sync = () => {
      clearInterval(timer);
      const playing = !paused && visible && !document.hidden;
      demo.dataset.playing = String(playing);
      play.setAttribute('aria-label', paused ? 'Play Rimewire demonstration' : 'Pause Rimewire demonstration');
      play.querySelector('[data-play-label]')!.textContent = paused ? 'Play' : 'Pause';
      if (playing) timer = setInterval(() => show((step + 1) % steps.length), 7000);
    };
    buttons.forEach((button, index) => button.addEventListener('click', () => { paused = true; show(index, true); sync(); }));
    play.addEventListener('click', () => { paused = !paused; sync(); });
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting && entries[0].intersectionRatio >= 0.25;
      sync();
    }, { threshold: 0.25 });
    observer.observe(demo);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', () => { if (reduced.matches) paused = true; sync(); });
    narrow.addEventListener('change', updateLink);
    window.addEventListener('pagehide', () => { clearInterval(timer); observer.disconnect(); });
    window.addEventListener('pageshow', () => { observer.observe(demo); sync(); });
    controls.hidden = false;
    updateLink();
    sync();
  }
</script>
