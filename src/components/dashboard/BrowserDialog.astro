---
import Icon from '../Icon.astro';
// One dialog serves every browser ward: Expand moves the ward's live view
// (the same element — one stream, one canvas) into the host below and the
// remote viewport follows the bigger surface. browser.ts owns all behavior;
// everything here is inert markup.
---

<dialog id="browser-dialog" class="fd-dialog fd-dialog-full">
  <form method="dialog" class="flex h-full flex-col gap-2 p-3">
    <div class="bw-dialog-heading">
      <h2 class="section-title truncate" data-bw-title>Browser</h2>
      <button type="button" class="btn min-h-0 px-2 py-1 text-xs" data-bw-close aria-label="Close"><Icon id="close" /></button>
    </div>
    <div class="flex min-h-0 flex-1 flex-col" data-bw-host></div>
  </form>
</dialog>
