---
import Icon from '../Icon.astro';
// The ward and expanded view share their composer in agent.ts.
---
<dialog id="agent-dialog" class="fd-dialog ag-dialog" aria-labelledby="agent-dialog-title">
  <header class="ag-dialog-header">
    <div class="ag-dialog-identity">
      <span class="ag-avatar"><Icon id="rime" /></span>
      <div><h2 id="agent-dialog-title" data-ag-title>Rime</h2><p class="ag-status" data-ag-status role="status">Rimeward agent</p></div>
    </div>
    <div class="ag-dialog-actions">
      <button type="button" class="ag-icon-button" data-ag-history aria-label="Chat history" title="Chat history and sync"><Icon id="history" /></button>
      <button type="button" class="ag-new-chat" data-ag-clear aria-label="New chat" title="New chat (archives this one)"><Icon id="plus" /> New chat</button>
      <button type="button" class="ag-icon-button" data-ag-close aria-label="Close chat" title="Close chat"><Icon id="close" /></button>
    </div>
  </header>
  <div class="ag-body" data-ag-body></div>
</dialog>
