---
// Share one ward or page (lib/shares.ts): who holds it and what they may do, and
// the anyone-with-the-link section when the instance allows it. Wired by
// scripts/app/share.ts, opened from a ward's or a page tab's menu.
import Icon from '../Icon.astro';
---

<dialog id="share-dialog" class="fd-dialog">
  <form method="dialog" class="flex flex-col gap-4 p-4" data-sh-form>
    <div class="flex items-center justify-between gap-2">
      <h2 class="section-title truncate" data-sh-title>Share</h2>
      <button type="button" class="btn min-h-0 px-2 py-1 text-xs" data-sh-close aria-label="Close"><Icon id="close" /></button>
    </div>
    <p class="text-xs text-ink-faint">People you share with see it live, in their own dashboard. You keep the layout, the settings and the leylines.</p>

    <div class="flex flex-col gap-2">
      <div class="flex flex-col gap-1" data-sh-people></div>
      <div class="flex flex-wrap items-end gap-2">
        <div class="min-w-48 flex-1">
          <label class="label" for="sh-email">Add a person</label>
          <input id="sh-email" data-sh-email type="email" class="input" placeholder="name@example.com" autocomplete="off" spellcheck="false" autofocus />
        </div>
        <div>
          <label class="label" for="sh-role">Access</label>
          <select id="sh-role" data-sh-role class="input"><option value="view">View</option><option value="edit">Edit</option></select>
        </div>
        <button type="button" class="btn" data-sh-add>Add</button>
      </div>
      <p class="text-xs text-err" data-sh-err hidden></p>
    </div>

    <div class="flex flex-col gap-2" data-sh-links>
      <p class="label">Anyone with the link</p>
      <div class="flex flex-col gap-1" data-sh-link-rows></div>
      <div class="flex flex-wrap items-end gap-2">
        <div>
          <label class="label" for="sh-link-role">Access</label>
          <select id="sh-link-role" data-sh-link-role class="input"><option value="view">View</option><option value="edit">Edit</option></select>
        </div>
        <div>
          <label class="label" for="sh-expiry">Expires</label>
          <select id="sh-expiry" data-sh-expiry class="input"><option value="0">Never</option><option value="86400">In 1 day</option><option value="604800">In 1 week</option><option value="2592000">In 30 days</option></select>
        </div>
        <button type="button" class="btn" data-sh-link>Create link</button>
      </div>
      <div class="flex flex-wrap items-center gap-2" data-sh-token hidden>
        <input type="text" class="input min-w-0 flex-1 text-xs" readonly data-sh-token-url aria-label="Share link" />
        <button type="button" class="btn-primary" data-sh-copy>Copy</button>
      </div>
      <p class="text-[10px] text-ink-faint" data-sh-token-hint hidden>Copy it now — the link is shown once. Revoke it here any time.</p>
    </div>
    <p class="text-xs text-ink-faint" data-sh-links-off hidden></p>

    <div class="flex items-center justify-end gap-2 border-t border-line/60 pt-3">
      <button type="button" class="btn-primary" data-sh-done>Done</button>
    </div>
  </form>
</dialog>
