<section class="border-b border-line py-5" data-embedding-settings>
  <h3 class="text-sm font-medium">Semantic retrieval</h3>
  <p class="mt-1 text-sm text-ink-muted">Find related memories, skills, notes and conversations.</p>
  <form class="mt-4 grid gap-4" aria-busy="true" data-workspace-checkpoint>
    <div class="grid min-w-0 gap-4 sm:grid-cols-2">
      <label class="min-w-0 text-sm">Run embeddings on
        <select name="provider" class="input mt-1 w-full">
          <option value="local">My computers · Qwen3-Embedding-8B</option>
          <option value="openai">OpenAI API</option><option value="openrouter">OpenRouter</option>
        </select>
      </label>
      <label class="min-w-0 text-sm" data-quantization>Model variant
        <select name="quantization" class="input mt-1 w-full">
          <option value="Q4_K_M">Q4_K_M · 4.68 GB</option><option value="Q8_0">Q8_0 · 8.05 GB</option>
        </select>
      </label>
      <label class="min-w-0 text-sm" data-openai hidden>Embedding model
        <select name="model" class="input mt-1 w-full">
          <option value="text-embedding-3-small">text-embedding-3-small</option><option value="text-embedding-3-large">text-embedding-3-large</option>
        </select>
      </label>
    </div>
    <fieldset class="min-w-0 rounded-xl border border-line p-3" data-runtimes hidden>
      <legend class="px-1 text-sm">Computer priority</legend>
      <p class="text-xs text-ink-muted">Enable the computers to use, in order. If one is unavailable, the next takes over.</p>
      <ol class="mt-3 grid" data-runtime-list aria-label="Embedding computer priority"></ol>
    </fieldset>
    <p class="text-xs text-ink-muted" data-selection-help></p>
    <label class="switch justify-between gap-4 rounded-xl border border-line p-3" data-sharing hidden>
      <span class="grid gap-1"><span>Share this computer’s model</span><span class="text-xs text-ink-muted">Let your other computers use it for search.</span></span>
      <input type="checkbox" role="switch" name="sharing" aria-label="Share this computer’s model" />
    </label>
    <div class="flex flex-wrap items-center gap-2" data-unsaved hidden>
      <button class="btn-primary" type="submit">Save changes</button>
      <button class="btn" type="button" data-discard>Discard changes</button>
      <span class="text-xs text-ink-muted">Unsaved changes</span>
    </div>
  </form>

  <div class="mt-4 rounded-xl border border-line p-4" data-status role="status" aria-live="polite" aria-atomic="true">
    <h4 class="text-sm font-semibold" data-state>Loading search status…</h4>
    <p class="mt-1 text-sm text-ink-muted" data-status-detail>Checking the saved provider and search index.</p>
    <p class="mt-2 text-sm text-err" data-error hidden></p>
    <p class="mt-2 text-xs text-ink-muted" data-advisory hidden></p>
    <dl class="mt-3 grid gap-3 text-xs sm:grid-cols-2" data-metrics hidden>
      <div><dt class="text-ink-muted">Using</dt><dd class="mt-1" data-location></dd></div>
      <div><dt class="text-ink-muted">Search index</dt><dd class="mt-1" data-index></dd></div>
    </dl>
    <progress class="mt-3 w-full" data-index-progress hidden aria-label="Semantic indexing progress"></progress>
    <p class="mt-2 text-xs text-ink-muted" data-timing hidden></p>
    <div class="mt-3 flex flex-wrap gap-2" data-model-actions>
      <button class="btn-primary" type="button" data-action="download" hidden>Download model</button>
      <button class="btn" type="button" data-action="unload" hidden>Unload model</button>
      <button class="btn" type="button" data-refresh hidden>Retry status</button>
    </div>
  </div>

  <div class="mt-3 grid gap-3" data-downloads hidden>
    <div class="rounded-xl border border-line p-3" data-download="runtime" hidden>
      <p class="text-sm" data-download-label></p>
      <progress class="mt-2 w-full" aria-label="Runtime download progress"></progress>
    </div>
    <div class="rounded-xl border border-line p-3" data-download="Q4_K_M" hidden>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm" data-download-label></p>
        <button class="btn text-xs" type="button" data-action="cancel" data-quantization="Q4_K_M">Cancel download</button>
      </div>
      <progress class="mt-2 w-full" aria-label="Q4_K_M download progress"></progress>
    </div>
    <div class="rounded-xl border border-line p-3" data-download="Q8_0" hidden>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm" data-download-label></p>
        <button class="btn text-xs" type="button" data-action="cancel" data-quantization="Q8_0">Cancel download</button>
      </div>
      <progress class="mt-2 w-full" aria-label="Q8_0 download progress"></progress>
    </div>
  </div>
  <p class="mt-3 text-sm" role="status" data-action-message hidden></p>
  <details class="mt-4 text-xs text-ink-muted" data-maintenance hidden>
    <summary class="cursor-pointer">Index maintenance</summary>
    <p class="mt-2">Recreate the search index if results seem out of date. Your original content is kept.</p>
    <button class="btn mt-2 text-xs" type="button" data-action="rebuild">Rebuild search index</button>
  </details>
</section>

<style>
  [data-embedding-settings] [hidden] { display: none !important; }
  [data-embedding-settings] dd, [data-error] { overflow-wrap: anywhere; }
  [data-status][data-tone="ready"] [data-state] { color: var(--color-ok); }
  [data-status][data-tone="error"] [data-state] { color: var(--color-err); }
  /* Runtime rows are created in the browser and do not have Astro's scope attribute. */
  [data-runtime-list] :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; min-width: 0; padding: .75rem 0; }
  [data-runtime-list] :global(li + li) { border-top: 1px solid var(--color-line); }
  [data-runtime-list] :global(label) { flex: 1; min-width: 0; justify-content: space-between; gap: .75rem; }
  [data-runtime-list] :global(.runtime-copy) { display: grid; gap: .2rem; min-width: 0; overflow-wrap: anywhere; }
  [data-runtime-list] :global(small) { font-size: .75rem; color: var(--color-ink-muted); }
  [data-runtime-list] :global(li[data-ready="true"] small) { color: var(--color-ok); }
  [data-runtime-list] :global(.runtime-order) { display: flex; flex: none; gap: .25rem; }
  [data-runtime-list] :global(.btn) { width: 2rem; height: 2rem; padding: 0; }
  [data-runtime-list] :global(.runtime-setup) { display: grid; gap: .5rem; width: 100%; }
  [data-runtime-list] :global(.runtime-setup .btn) { width: fit-content; height: auto; padding: .4rem .75rem; font-size: .75rem; }
  [data-runtime-list] :global(progress) { width: 100%; }
  [data-runtime-list] :global(input:focus-visible), [data-sharing] input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  progress { display: block; height: .45rem; appearance: none; border: 0; border-radius: 1rem; overflow: hidden; background: var(--color-line); }
  progress::-webkit-progress-bar { background: var(--color-line); }
  progress::-webkit-progress-value { background: var(--color-accent); }
  progress::-moz-progress-bar { background: var(--color-accent); }
</style>

<script>
  import { icon } from '../scripts/app/icon.ts';
  import type { EmbeddingConfig } from '../lib/agent/embedding-profiles.ts';
  import type { localEmbeddingStatus } from '../lib/agent/embedding-local.ts';
  import type { KnowledgeStatus } from '../lib/agent/knowledge.ts';
  type Device = { id:string; name:string; online:boolean; inference?:{ sharing:boolean; ready:boolean; quantization:string; queryMs?:number } | null };
  type ServerHost = { hosting:boolean; ready:boolean; quantization:string; location?:string;
    runtime?:ReturnType<typeof localEmbeddingStatus>['runtime']; models:ReturnType<typeof localEmbeddingStatus>['models'] } | null;
  type Status = { config:EmbeddingConfig; desktop:boolean; local:ReturnType<typeof localEmbeddingStatus>; server:ServerHost;
    holds:Record<string,string>; index:Partial<KnowledgeStatus>; devices:Device[]; timing?:{ queryMs:number; runtime?:string } | null };
  /** One selectable runtime, as the priority list and the status card both read it. */
  type Candidate = { id:string; name:string; ready:boolean; note:string; blocker:string };
  const root = document.querySelector<HTMLElement>('[data-embedding-settings]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const element = <T extends HTMLElement = HTMLElement>(name:string) => root.querySelector<T>('[data-' + name + ']')!;
    const text = (name:string,value:string) => {
      const node = element(name); if (node.textContent !== value) node.textContent = value; return node;
    };
    const field = (name:string) => form.elements.namedItem(name) as HTMLSelectElement;
    const sharing = form.elements.namedItem('sharing') as HTMLInputElement;
    const button = (name:string) => root.querySelector<HTMLButtonElement>('[data-action="' + name + '"]')!;
    let data:Status | undefined, settled = '', initialized = false, revision = 0, pendingAction = '', statusError = '';
    let saving:Promise<void> | undefined, refreshing:Promise<void> | undefined;
    // The draft priority list: every candidate in display order, the checked ones being the selection.
    let order:string[] = [], chosen = new Set<string>(), listSignature = '';
    const candidates = (s:Status,quantization:string):Candidate[] => {
      const out:Candidate[] = [];
      const local = s.local, model = local.models.find(m => m.quantization === quantization);
      const here = s.desktop ? 'This desktop' : 'This server';
      out.push(!local.runtime.binary ? { id:'local',name:here,ready:false,note:'not set up',blocker:here + ': no model set up' }
        : !model?.installed ? { id:'local',name:here,ready:false,note:'model not downloaded',blocker:here + ': model not downloaded' }
        : { id:'local',name:here,ready:true,note:'ready',blocker:'' });
      if (s.desktop) {
        const server = s.server, name = 'Paired server' + (server?.location ? ' · ' + server.location : '');
        out.push(!server ? { id:'server',name,ready:false,note:'not connected',blocker:'paired server: not connected' }
          : !server.hosting ? { id:'server',name,ready:false,note:'no model on the server',blocker:'paired server: no model set up' }
          : !server.models.some(m => m.quantization === quantization && m.installed) ? { id:'server',name,ready:false,note:quantization + ' not downloaded there',blocker:'paired server: ' + quantization + ' not downloaded' }
          : { id:'server',name,ready:true,note:'ready',blocker:'' });
      }
      for (const d of s.devices) {
        const i = d.inference;
        out.push(!d.online ? { id:d.id,name:d.name,ready:false,note:'offline',blocker:d.name + ': offline' }
          : !i ? { id:d.id,name:d.name,ready:false,note:'unreachable',blocker:d.name + ': unreachable' }
          : !i.sharing ? { id:d.id,name:d.name,ready:false,note:'not sharing',blocker:d.name + ': enable sharing in its retrieval settings' }
          : i.quantization !== quantization ? { id:d.id,name:d.name,ready:false,note:'shares ' + i.quantization,blocker:d.name + ': shares ' + i.quantization }
          : !i.ready ? { id:d.id,name:d.name,ready:false,note:'setup needed',blocker:d.name + ': download the model there' }
          : { id:d.id,name:d.name,ready:true,note:'ready',blocker:'' });
      }
      for (const [id,reason] of Object.entries(s.holds)) { const c = out.find(c => c.id === id); if (c && c.ready) { c.ready = false; c.note = 'retrying soon'; c.blocker = c.name + ': ' + reason; } }
      return out;
    };
    const config = ():EmbeddingConfig => {
      const provider = field('provider').value as EmbeddingConfig['provider'];
      return { provider,quantization:provider === 'local' ? field('quantization').value as EmbeddingConfig['quantization'] : data!.config.quantization,
        model:provider === 'openai' ? field('model').value : provider === 'openrouter' ? 'qwen/qwen3-embedding-8b' : 'Qwen3-Embedding-8B',
        runtimes:provider === 'local' ? order.filter(id => chosen.has(id)) : [],sharing:sharing.checked };
    };
    const fingerprint = (c:EmbeddingConfig) => JSON.stringify([c.provider,c.quantization,c.model,c.runtimes,c.sharing]);
    const dirty = () => initialized && fingerprint(config()) !== settled;
    const fill = (c:EmbeddingConfig) => {
      field('provider').value = c.provider; field('quantization').value = c.quantization;
      field('model').value = c.provider === 'openai' ? c.model : 'text-embedding-3-small';
      const known = data ? candidates(data,c.quantization).map(x => x.id) : [];
      order = [...c.runtimes,...known.filter(id => !c.runtimes.includes(id))]; chosen = new Set(c.runtimes);
      sharing.checked = c.sharing;
      settled = fingerprint(c); initialized = true;
    };
    const message = (text:string,error = false) => {
      const node = element('action-message'); node.textContent = text; node.hidden = !text;
      node.classList.toggle('text-err',error);
    };
    const renderRuntimes = (draft:EmbeddingConfig) => {
      if (!data) return;
      const known = candidates(data,draft.quantization);
      for (const c of known) if (!order.includes(c.id)) order.push(c.id);
      const rows = order.map(id => known.find(c => c.id === id) ?? { id,name:'Unpaired desktop',ready:false,note:'no longer paired',blocker:'' });
      const signature = JSON.stringify([rows,[...chosen],!initialized || !!pendingAction,draft.quantization,data.server,statusError]);
      if (signature === listSignature) return;
      listSignature = signature;
      const list = element<HTMLOListElement>('runtime-list');
      const focused = document.activeElement as HTMLElement | null;
      const focusedRow = focused?.closest('li');
      const focusId = focusedRow && list.contains(focusedRow) ? focusedRow.dataset.runtime : undefined;
      const focusIndex = focusedRow ? [...focusedRow.querySelectorAll('input,button')].indexOf(focused!) : -1;
      list.replaceChildren();
      rows.forEach((c,i) => {
        const li = document.createElement('li'); li.dataset.ready = String(c.ready); li.dataset.runtime = c.id;
        const label = document.createElement('label'), box = document.createElement('input');
        label.className = 'switch'; box.setAttribute('role','switch');
        box.type = 'checkbox'; box.checked = chosen.has(c.id); box.disabled = !initialized || !!pendingAction;
        box.setAttribute('aria-label','Use ' + c.name + ' for embeddings');
        box.title = box.checked ? 'Disable this computer' : 'Enable this computer';
        box.onchange = () => { if (box.checked) chosen.add(c.id); else chosen.delete(c.id); message(''); render(); };
        const copy = document.createElement('span'); copy.className = 'runtime-copy';
        const name = document.createElement('span'); name.textContent = c.name;
        const note = document.createElement('small'); note.textContent = c.note;
        copy.append(name,note); label.append(copy,box);
        const moves = document.createElement('span'); moves.className = 'runtime-order';
        const up = document.createElement('button'), down = document.createElement('button');
        up.type = down.type = 'button'; up.className = down.className = 'btn';
        up.append(icon('up')); down.append(icon('down'));
        up.title = 'Try ' + c.name + ' earlier'; down.title = 'Try ' + c.name + ' later';
        up.setAttribute('aria-label',up.title); down.setAttribute('aria-label',down.title);
        up.disabled = i === 0 || !initialized || !!pendingAction; down.disabled = i === rows.length-1 || !initialized || !!pendingAction;
        up.onclick = () => { [order[i-1],order[i]] = [order[i]!,order[i-1]!]; message(''); render(); };
        down.onclick = () => { [order[i+1],order[i]] = [order[i]!,order[i+1]!]; message(''); render(); };
        moves.append(up,down); li.append(label,moves);
        if (c.id === 'server' && data!.server) {
          const server = data!.server, runtime = server.runtime;
          const model = server.models.find(m => m.quantization === draft.quantization);
          const downloading = server.models.find(m => m.download && !m.download.done);
          const installing = !!runtime?.install && !runtime.install.done;
          const setup = document.createElement('div'); setup.className = 'runtime-setup';
          if (installing || downloading) {
            const label = document.createElement('small'), progress = document.createElement('progress');
            progress.setAttribute('aria-label','Paired server model setup progress');
            label.textContent = installing ? 'Installing server runtime · ' + (runtime!.install!.received/1e6).toFixed(0) + ' MB'
              : 'Downloading ' + downloading!.quantization + ' on server · ' + (downloading!.download!.received/1e9).toFixed(2) + ' / ' + (downloading!.bytes/1e9).toFixed(2) + ' GB';
            if (downloading) { progress.max = downloading.bytes; progress.value = downloading.download!.received; }
            setup.append(label,progress);
          }
          const error = runtime?.install?.error || model?.download?.error;
          if (error) { const label = document.createElement('small'); label.className = 'text-err'; label.textContent = error; setup.append(label); }
          if (downloading || !installing && !model?.installed && (server.hosting || runtime?.installable)) {
            const install = document.createElement('button'); install.type = 'button'; install.className = 'btn';
            install.disabled = !initialized || !!pendingAction || !!statusError;
            install.textContent = downloading ? 'Cancel server download' : 'Install ' + draft.quantization + ' on server · ' + (draft.quantization === 'Q4_K_M' ? '4.68 GB' : '8.05 GB');
            install.onclick = () => void action(downloading ? 'cancel' : 'download',(downloading?.quantization as EmbeddingConfig['quantization'] | undefined) ?? draft.quantization,'server').catch(() => {});
            setup.append(install);
          } else if (!runtime && !server.hosting) {
            const label = document.createElement('small'); label.textContent = 'Update the server to install its model from this app.'; setup.append(label);
          } else if (!server.hosting && !runtime?.installable) {
            const label = document.createElement('small'); label.textContent = 'Model installation is unavailable on this server platform.'; setup.append(label);
          }
          if (setup.childElementCount) li.append(setup);
        }
        list.append(li);
      });
      if (focusId) {
        const row = [...list.children].find(row => (row as HTMLElement).dataset.runtime === focusId);
        const controls = row?.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input,button');
        const next = controls?.[focusIndex];
        (next?.disabled ? controls?.[0] : next)?.focus({ preventScroll:true });
      }
    };
    const render = () => {
      for (const control of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('select,input[name]')) control.disabled = !initialized;
      for (const control of root.querySelectorAll<HTMLButtonElement>('button[data-action],button[data-discard],button[data-refresh],button[type="submit"]')) control.disabled = !initialized || !!pendingAction;
      element<HTMLButtonElement>('refresh').disabled = !!refreshing;
      form.setAttribute('aria-busy',String(!initialized || pendingAction === 'save'));
      if (!data) return;
      const draft = config(), changed = dirty(), current = data.config;
      const local = data.local, runtime = local.runtime, model = local.models.find(m => m.quantization === current.quantization);
      element('quantization').hidden = draft.provider !== 'local';
      element('runtimes').hidden = draft.provider !== 'local'; element('openai').hidden = draft.provider !== 'openai';
      element('sharing').hidden = draft.provider !== 'local' || !runtime.binary && !runtime.installable;
      if (draft.provider === 'local') renderRuntimes(draft);
      element('selection-help').textContent = draft.provider === 'local'
        ? (draft.quantization === 'Q4_K_M' ? 'About 7 GiB of memory on each computer that hosts it; Q4 is the default.' : 'About 11 GiB of memory on each computer that hosts it.') + ' Only text and vectors travel between computers; the search index stays here.'
        : (draft.provider === 'openai' ? 'Uses the saved OpenAI API key.' : 'Uses the saved OpenRouter API key and qwen/qwen3-embedding-8b.') + ' Text is sent to this provider. ChatGPT sign-in does not supply embeddings.';
      element('unsaved').hidden = !changed && pendingAction !== 'save';
      const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      submit.textContent = pendingAction === 'save' ? 'Saving…' : 'Save changes';
      if (draft.provider === 'local' && !draft.runtimes.length) submit.disabled = true;
      const list = current.provider === 'local' ? candidates(data,current.quantization) : [];
      const picked = current.runtimes.map(id => list.find(c => c.id === id) ?? { id,name:'Unpaired desktop',ready:false,note:'',blocker:'an unpaired desktop' });
      const active = picked.find(c => c.ready);
      const hostsHere = current.provider === 'local' && current.runtimes.includes('local');
      const downloading = !!model?.download && !model.download.done, installing = !!runtime.install && !runtime.install.done;
      const { chunks = 0,embedded = 0,indexing = false } = data.index;
      let title = 'Semantic search ready', detail = 'Your knowledge is ready to search.', tone = 'ready', error = '';
      if (current.provider === 'local' && !current.runtimes.length) {
        title = 'Choose where embeddings run'; detail = 'Add at least one computer to the priority list. Keyword search is available.'; tone = '';
      } else if (hostsHere && installing) {
        title = 'Installing the inference runtime'; detail = 'llama.cpp is downloading. The model follows. Keyword search remains available.'; tone = '';
      } else if (hostsHere && downloading) {
        title = 'Downloading ' + current.quantization; detail = 'Download progress is below. Keyword search remains available.'; tone = '';
      } else if (hostsHere && (!runtime.binary || !model?.installed) && !active) {
        title = runtime.binary ? 'Download a model to get started' : (data.desktop ? 'Set up this desktop' : 'Set up this server');
        detail = 'Keyword search is available now. ' + (runtime.binary ? 'Download the model to enable semantic retrieval.' : 'Install the runtime and model here, or put another computer first.'); tone = '';
        error = runtime.install?.error ?? model?.download?.error ?? '';
        if (error === 'Download cancelled.') { title = 'Download cancelled'; error = ''; }
        else if (error) { title = 'Setup failed'; tone = 'error'; }
      } else if (current.provider === 'local' && !active) {
        title = 'No computer is available'; detail = picked.map(c => c.blocker).filter(Boolean).join(' · ') + '. Keyword search still works.'; tone = '';
      } else if (hostsHere && active?.id === 'local' && local.unloaded) {
        title = 'Model unloaded'; detail = 'Memory has been released. The next search will load the model again.'; tone = '';
      } else if (indexing) {
        title = active?.id === 'local' && !local.ready ? 'Starting the local model' : 'Indexing your knowledge';
        detail = 'You can search now. Semantic coverage grows as indexing finishes.'; tone = '';
      } else if (data.index.vectorError || data.index.error || active?.id === 'local' && local.error) {
        title = 'Semantic search needs attention'; detail = 'Keyword search is still available.'; tone = 'error';
        error = data.index.vectorError || data.index.error || local.error || '';
      } else if (!chunks) {
        title = 'Nothing to index yet'; detail = 'Memories, skills, notes and conversations are indexed automatically as you add them.'; tone = '';
      } else if (embedded < chunks) {
        title = 'Preparing the search index'; detail = 'Keyword search works while the remaining passages are indexed.'; tone = '';
      }
      if (statusError) { title = 'Status unavailable'; detail = 'Could not refresh retrieval status. Retrying automatically.'; error = statusError; tone = 'error'; }
      element('status').dataset.tone = tone; text('state',title); text('status-detail',detail);
      text('error',error).hidden = !error;
      const advisory = active?.id === 'local' ? model?.recommendation ?? '' : '';
      text('advisory',advisory).hidden = !advisory;
      const standby = picked.filter(c => c !== active).map(c => c.name + ' (' + (c.note || 'unpaired') + ')');
      const location = current.provider === 'local' ? (active ? active.name : 'No computer available') + (standby.length ? ' · then ' + standby.join(', ') : '')
        : current.provider === 'openai' ? 'OpenAI API' : 'OpenRouter';
      text('location',location + ' · ' + (current.provider === 'local' ? current.quantization : current.model));
      text('index',data.index.chunks == null || data.index.embedded == null ? 'Index status unavailable' : embedded.toLocaleString() + ' of ' + chunks.toLocaleString() + ' passages ready');
      element('metrics').hidden = false;
      const indexProgress = element<HTMLProgressElement>('index-progress');
      indexProgress.hidden = !indexing || !chunks; indexProgress.max = Math.max(1,chunks); indexProgress.value = embedded;
      const queryMs = data.timing?.queryMs;
      const timing = [active?.id === 'local' && local.startupMs != null ? 'Model startup: ' + local.startupMs + ' ms' : '',queryMs != null ? 'Last search embedding: ' + queryMs + ' ms' : ''].filter(Boolean).join(' · ');
      text('timing',timing).hidden = !timing;
      const size = current.quantization === 'Q4_K_M' ? '4.68 GB' : '8.05 GB';
      button('download').hidden = changed || !!statusError || !hostsHere || !!model?.installed || downloading || installing || !runtime.binary && !runtime.installable;
      button('download').textContent = pendingAction === 'download' ? 'Starting download…'
        : ((runtime.install?.error || model?.download?.error) && model?.download?.error !== 'Download cancelled.' ? 'Retry setup' : runtime.binary ? 'Download model' : 'Install runtime and model') + ' · ' + size;
      button('unload').hidden = changed || !!statusError || !local.ready;
      button('unload').textContent = pendingAction === 'unload' ? 'Unloading model…' : 'Unload ' + (local.loaded ?? '') + ' from memory';
      element('refresh').hidden = !statusError;
      element('model-actions').hidden = button('download').hidden && button('unload').hidden && element('refresh').hidden;
      element('maintenance').hidden = changed || !!statusError || !chunks || indexing || !!pendingAction;
      let activeDownloads = false;
      for (const row of root.querySelectorAll<HTMLElement>('[data-download]')) {
        if (row.dataset.download === 'runtime') {
          row.hidden = !installing; if (!installing) continue;
          activeDownloads = true;
          row.querySelector('[data-download-label]')!.textContent = 'llama.cpp ' + runtime.version + ' · ' + (runtime.install!.received/1e6).toFixed(0) + ' MB';
          row.querySelector('progress')!.removeAttribute('value');
          continue;
        }
        const m = local.models.find(m => m.quantization === row.dataset.download), download = m?.download;
        const active = !!download && !download.done; row.hidden = !active;
        if (!active || !m) continue;
        activeDownloads = true;
        row.querySelector('[data-download-label]')!.textContent = m.quantization + ' · ' + (download.received/1e9).toFixed(2) + ' / ' + (m.bytes/1e9).toFixed(2) + ' GB';
        const progress = row.querySelector('progress')!; progress.max = m.bytes; progress.value = download.received;
      }
      element('downloads').hidden = !activeDownloads;
    };
    const refresh = ():Promise<void> => {
      if (refreshing) return refreshing;
      const version = revision;
      refreshing = (async () => {
        try {
          const response = await fetch('/api/account/embeddings',{ signal:AbortSignal.timeout(15000) });
          if (!response.ok) throw Error('Retrieval settings could not be loaded (' + response.status + ').');
          const next:Status = await response.json();
          if (version !== revision) return;
          const clean = !dirty();
          data = next; statusError = '';
          if (clean) fill(next.config);
        } catch (e) {
          if (version !== revision) return;
          statusError = e instanceof Error ? e.message : String(e);
          element('status').dataset.tone = 'error';
          text('state','Status unavailable'); text('status-detail',statusError);
          element('refresh').hidden = false;
        }
      })().finally(() => { refreshing = undefined; render(); });
      render(); return refreshing;
    };
    const action = async (name:string,quantization = config().quantization,target = 'local') => {
      if (pendingAction) return;
      const value = config(); pendingAction = name; revision++; message(''); render();
      try {
        const response = await fetch('/api/account/embeddings',{ method:'POST',headers:{ 'content-type':'application/json' },
          body:JSON.stringify({ action:name,quantization,config:value,target }),signal:AbortSignal.timeout(15000) });
        const result = await response.json(); if (!response.ok) throw Error(result.error ?? 'Retrieval action failed.');
        if (name === 'save') settled = fingerprint(result.config);
        if (name === 'save') message('Settings saved.');
        await refreshing; await refresh();
      } catch (e) { message(e instanceof Error ? e.message : String(e),true); throw e; }
      finally { pendingAction = ''; render(); }
    };
    form.onsubmit = event => {
      event.preventDefault(); if (!initialized || !dirty() || pendingAction) return;
      saving = action('save').finally(() => { saving = undefined; });
      void saving.catch(() => {});
    };
    form.addEventListener('change',() => { message(''); render(); });
    element('discard').onclick = () => { if (data) { fill(data.config); message(''); render(); } };
    element('refresh').onclick = () => void refresh();
    for (const control of root.querySelectorAll<HTMLButtonElement>('[data-action]')) control.onclick = () => {
      if (!initialized || pendingAction) return;
      void action(control.dataset.action!,control.dataset.quantization as EmbeddingConfig['quantization'] | undefined).catch(() => {});
    };
    window.addEventListener('fd:before-workspace-navigation',event => {
      (event as CustomEvent<{ waitUntil(p:Promise<unknown>):void }>).detail.waitUntil((async () => {
        await saving;
        if (dirty()) throw Error('Save or finish editing your retrieval settings before relaunching.');
      })());
    });
    render(); void refresh();
    const timer = setInterval(() => { if (!document.hidden) void refresh(); },5000);
    window.addEventListener('pagehide',() => clearInterval(timer),{ once:true });
  }
</script>
