---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getDb } from '../../lib/db.ts';
import { listUsers } from '../../lib/users.ts';
import { sessionId } from '../../lib/auth.ts';
import { takeSetting } from '../../lib/settings.ts';
import { cardsToLines, siteInfo } from '../../lib/site.ts';
import { updateState } from '../../lib/updates.ts';
import { isDesktop } from '../../lib/dev/runtime.ts';

const me = Astro.locals.user!;
const users = listUsers();
const identities=getDb().prepare('SELECT user_id,connector,issuer,subject FROM login_identities').all() as {user_id:number;connector:string;issuer:string;subject:string}[];
// How a row can actually sign in. Neither a password nor an identity means
// nobody can — the bug an invitation exists to avoid.
const signIn = (u: { id: number; has_password: unknown }) =>
  [u.has_password ? 'password' : null, ...identities.filter((i) => i.user_id === u.id).map((i) => i.connector)].filter(Boolean).join(' + ');
const site = siteInfo();
const updates = await updateState();
// The desktop owner signs in through the app itself, not a password or an identity.
const desktop = isDesktop();

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
// A password generated by the previous request, shown exactly once.
const flashPw = ok === 'created' || ok === 'reset' ? takeSetting(`flash_pw:${sessionId(Astro.cookies)}`) : null;

const OK_MESSAGES: Record<string, string> = {
  invited: 'Invitation created.',
  created: 'User created.',
  reset: 'Password reset.',
  role: 'Role updated.',
  deleted: 'User deleted.',
  site: 'Site saved.',
  update: 'Update settings saved.',
};
---

<BaseLayout title={`Admin — ${site.name}`}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="page-head">
      <h1 class="page-title">Users</h1>
      <AdminNav current="users" />
    </div>

    {ok && <p class="banner banner-ok">{OK_MESSAGES[ok] ?? ok}</p>}
    {
      flashPw && (
        <p class="banner banner-info">
          One-time password (shown once):&nbsp;<code class="font-mono font-semibold select-all">{flashPw}</code>
        </p>
      )
    }
    {err && <p class="banner banner-err">{err}</p>}

    <div class="card mb-8 p-4">
      <h2 class="section-title mb-3">Add user</h2>
      <form method="post" action="/api/users" class="flex flex-wrap items-end gap-3">
        <div class="min-w-52 flex-1">
          <label for="new-email" class="label">Email</label>
          <input id="new-email" name="email" type="email" required class="input" placeholder="name@example.com" />
        </div>
        <div>
          <label for="new-role" class="label">Role</label>
          <select id="new-role" name="role" class="input">
            <option value="member">member</option>
            <option value="admin">admin</option>
          </select>
        </div>
        <div>
          <label for="new-mode" class="label">Sign-in</label>
          <select id="new-mode" name="mode" class="input">
            <option value="email">Email invitation</option>
            <option value="password">Generated password</option>
          </select>
        </div>
        <button type="submit" class="btn-primary">Add</button>
      </form>
      <p class="mt-2 text-xs text-ink-faint">
        Email invitations expire after one hour. Configure email delivery under Settings first.
      </p>
    </div>

    <div class="card table-wrap p-0">
      <table class="table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th class="hidden sm:table-cell">Sign-in</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            users.map((u) => (
              <tr>
                <td>
                  {u.email} · {u.status}
                  {u.id === me.userId && <span class="ml-1 text-xs text-ink-faint">(you)</span>}
                </td>
                <td>
                  <span class="pill" data-status={u.role}>{u.role}</span>
                </td>
                <td class="hidden text-ink-muted sm:table-cell">{signIn(u) || (u.status === 'pending' ? 'invitation pending' : desktop && u.id === me.userId ? 'this desktop app' : <span class="text-err">no sign-in method</span>)}</td>
                <td class="text-right">
                  <details class="relative inline-block text-left">
                    <summary class="btn cursor-pointer list-none px-2 py-1 text-xs">Manage</summary>
                    <div class="card absolute right-0 z-10 mt-1 flex w-44 flex-col gap-1 p-2 shadow-lg">
                      <form method="post" action={`/api/users/${u.id}`}><input type="hidden" name="action" value="status"/><input type="hidden" name="status" value={u.status==='active'?'suspended':'active'}/><button class="btn">{u.status==='active'?'Suspend':'Activate / approve'}</button></form>
                      <form method="post" action={`/api/users/${u.id}`}><button class="btn" name="action" value="revoke">Revoke sessions & devices</button></form>
                      <form method="post" action={`/api/users/${u.id}`}><input type="hidden" name="action" value="name"/><label>Display name<input class="input" name="name" value={u.display_name}/></label><button class="btn">Save name</button></form>
                      {identities.filter(i=>i.user_id===u.id).map(i=><form method="post" action={`/api/users/${u.id}`}><input type="hidden" name="action" value="unlink-identity"/><input type="hidden" name="connector" value={i.connector}/><input type="hidden" name="issuer" value={i.issuer}/><input type="hidden" name="subject" value={i.subject}/><button class="btn">Unlink {i.connector}</button></form>)}
                      <form method="post" action={`/api/users/${u.id}`}>
                        <input type="hidden" name="action" value="role" />
                        <input type="hidden" name="role" value={u.role === 'admin' ? 'member' : 'admin'} />
                        <button type="submit" class="btn w-full text-xs">
                          Make {u.role === 'admin' ? 'member' : 'admin'}
                        </button>
                      </form>
                      <form method="post" action={`/api/users/${u.id}`}>
                        <input type="hidden" name="action" value="reset-password" />
                        <button type="submit" class="btn w-full text-xs">Reset password</button>
                      </form>
                      <form
                        method="post"
                        action={`/api/users/${u.id}`}
                        onsubmit={`return confirm('Delete ${u.email}? Their sessions and linked accounts go too.')`}
                      >
                        <input type="hidden" name="action" value="delete" />
                        <button type="submit" class="btn-danger w-full text-xs">Delete</button>
                      </form>
                    </div>
                  </details>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {/* What the public pages say (lib/site.ts). The art is a file drop: data/brand/, or `rimeward brand install`. */}
    <div class="card mt-8 p-4">
      <h2 class="section-title mb-3">Site</h2>
      <form method="post" action="/api/admin/site" class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="site-name" class="label">Name</label>
          <input id="site-name" name="name" class="input" value={site.name} maxlength="60" />
        </div>
        <div>
          <label for="site-tagline" class="label">Tagline</label>
          <input id="site-tagline" name="tagline" class="input" value={site.tagline} maxlength="120" />
        </div>
        <div class="sm:col-span-2">
          <label for="site-footer" class="label">Splash footer</label>
          <input id="site-footer" name="footer" class="input" value={site.footer} maxlength="200" placeholder="© You · you@example.com" />
        </div>
        <div class="sm:col-span-2">
          <label for="site-cards" class="label">Splash cards — one per line as <code>Title | blurb</code>, up to 6</label>
          <textarea id="site-cards" name="cards" class="input" rows="4">{cardsToLines(site.cards)}</textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="links" checked={site.links} /> Public share links</label>
          <p class="mt-1 text-xs text-ink-faint">Members may share a ward or page with anyone holding a link (view-only). Off: sharing stays between accounts.</p>
        </div>
        <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
          <button type="submit" class="btn-primary">Save</button>
          <span class="text-xs text-ink-faint">
            Wordmark, emblem, mark and icons: drop files into <code>data/brand/</code> or run <code>node bin/rimeward.mjs brand install</code>.
          </span>
        </div>
      </form>
    </div>

    {/* Updates (lib/updates.ts): the policy, what is installed vs published, an install or a rollback. */}
    <div class="card mt-8 p-4">
      <h2 class="section-title mb-3">Updates</h2>
      <p class="text-sm text-ink-muted">
        {/* A desktop runtime has no server release of its own (lib/updates.ts): show the app's. */}
        {(() => { const app = updates.server ?? updates.desktop; const name = updates.server ? 'Server' : 'Rimeward'; return app ? `${name} v${app.current}${app.available ? ` — v${app.latest} is available` : ' — up to date'}` : 'Version unknown'; })()}
        {updates.error && <span> · last check failed: {updates.error}</span>}
        {updates.previous && <span> · v{updates.previous} kept for a rollback</span>}
        {updates.job && !updates.job.done && <span> · installing v{updates.job.version}: {updates.job.log.at(-1)}</span>}
        {updates.job?.error && <span> · last install failed: {updates.job.error}</span>}
      </p>
      <form method="post" action="/api/admin/update" class="mt-3 flex flex-wrap items-end gap-3">
        <div>
          <label for="update-policy" class="label">When a newer release is published</label>
          <select id="update-policy" name="policy" class="input">
            <option value="notify" selected={updates.policy === 'notify'}>Notify — the header chip and the "Update available" leyline</option>
            <option value="install" selected={updates.policy === 'install'} disabled={updates.install !== 'node'}>Install it and restart</option>
            <option value="off" selected={updates.policy === 'off'}>Do nothing</option>
          </select>
        </div>
        <button type="submit" class="btn-primary">Save</button>
        <button type="submit" name="refresh" value="1" class="btn">Check now</button>
        {updates.install === 'node' && updates.server?.available && !(updates.job && !updates.job.done) && (
          <button type="submit" name="install" value="1" class="btn">Install v{updates.server.latest} and restart</button>
        )}
        {updates.install === 'node' && updates.previous && <button type="submit" name="rollback" value="1" class="btn">Roll back to v{updates.previous}</button>}
      </form>
      <p class="mt-2 text-xs text-ink-faint">
        {updates.install === 'docker'
          ? `Docker install: pull ${updates.image} and recreate the container.`
          : 'An install stages the release beside this checkout, then swaps it in; the previous tree stays for a rollback. The same from a shell: node bin/rimeward.mjs update.'}
      </p>
    </div>
  </main>
</BaseLayout>
