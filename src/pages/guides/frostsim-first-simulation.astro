---
import GuideLayout from '../../layouts/GuideLayout.astro';

const chapters = [
  { id: 'import', title: 'Import and check your character' },
  { id: 'conditions', title: 'Choose the conditions' },
  { id: 'quick-sim', title: 'Run and read Quick Sim' },
  { id: 'top-gear', title: 'Search with Top Gear' },
  { id: 'droptimizer', title: 'Find useful drops' },
  { id: 'compare', title: 'Compare and plan upgrades' },
  { id: 'reports', title: 'Keep and share reports' },
  { id: 'troubleshoot', title: 'Check status and recover' },
