---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RimewardLockup, RimewardMark, brandSrc } from '../lib/brand.ts';
import { siteInfo } from '../lib/site.ts';

// Everything this page says is a setting (lib/site.ts) and every picture a
// brand slot (lib/brand.ts): the repo ships Rimeward, an instance its own.
const site = siteInfo();
const wordmark = brandSrc('wordmark');
const emblem = brandSrc('emblem');
---

<BaseLayout title={site.name} description={`${site.name} — ${site.tagline}`} index>
  <div class="splash-ground">
    {emblem ? <img src={emblem} alt="" class="emblem" loading="eager" /> : <RimewardMark class="emblem" aria-hidden="true" />}
  </div>
  <canvas id="splash-canvas" aria-hidden="true"></canvas>

  <section class="splash-overlay">
    {
      wordmark ? (
        <img src={wordmark} alt={site.name} class="splash-wordmark" loading="eager" />
      ) : (
        <RimewardLockup class="splash-wordmark" aria-label={site.name} />
      )
    }
    <p class="splash-tagline">{site.tagline}</p>
    <a id="enter" href="/login" class="splash-enter">Enter</a>
  </section>

  <section class="splash-band">
    {
      site.cards.length > 0 && (
        <div class="mx-auto w-full max-w-4xl">
          <h2 class="section-title mb-4 text-center">What runs here</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {site.cards.map((c) => (
              <article class="card p-5">
                <h3 class="text-base font-semibold">{c.title}</h3>
                {c.blurb && <p class="mt-1 text-sm text-ink-muted">{c.blurb}</p>}
              </article>
            ))}
          </div>
        </div>
      )
    }
    {site.footer && <footer class="splash-foot">{site.footer}</footer>}
  </section>
</BaseLayout>

<style>
  /* The terrain fills the frame with mid-tones; a soft dark pool behind the
     brand block keeps the wordmark legible over any part of the landscape. */
  .splash-overlay::before {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(92vw, 56rem);
    height: 24rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(2 8 16 / 0.55), transparent 72%);
    pointer-events: none;
    z-index: -1;
  }

  /* Hero is 100vh (.splash-overlay); this band adds ~120vh so the page totals
     ~220vh and scroll drives the scene. */
  .splash-band {
    position: relative;
    z-index: 1;
    min-height: 120vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    padding: 24vh 1.5rem 2rem;
    background: linear-gradient(to bottom, transparent, rgb(6 13 24 / 0.9) 35%);
  }
  .splash-foot {
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: #5c7189;
  }
</style>

<script>
  import '../scripts/splash/index.ts';
</script>
