---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { RimewardLockup } from '../lib/brand.ts';
import Icon from '../components/Icon.astro';
import WardDemo from '../components/marketing/WardDemo.astro';
import { CATALOG } from '../lib/wards.ts';
import { ICONS } from '../lib/icon-names.ts';
import { iconSvg } from '../lib/icons.ts';
import '../styles/products.css';

const source = 'https://github.com/frostdev-ops/rimeward';
const download = `${source}/releases/latest`;
const wardExamples = [
  ['editor', 'Make something.'], ['browser', 'Keep the web in reach.'],
  ['note', 'Write it down.'], ['notebook', 'Give ideas a home.'],
  ['agent', 'Work with an AI partner.'], ['timer', 'Make time for it.'],
  ['button', 'Start a connected action.'], ['terminal', 'Use your own tools.'],
];
---

<MarketingLayout title="Rimeward — Your tools, working together." description="Build your workspace from wards. Bring notes, browsers, projects and Rime together, then connect them with Leylines. By Frostdev." path="/rimeward" image="/projects/rimeward-editor.webp">
  <div class="product-page rimeward-page">
    <section class="product-hero" aria-labelledby="rimeward-title">
      <div class="product-intro">
        <p class="product-eyebrow">The rime remembers</p>
        <RimewardLockup class="product-logo" aria-label="Rimeward" />
        <h1 class="product-title" id="rimeward-title">Your tools.<br />Working together.</h1>
        <p class="product-lead">A ward is a tool on your page. Bring your notes, browser, projects and Rime together. Arrange them your way. Connect them with Leylines.</p>
        <div class="product-actions">
          <a class="product-button" href={download}>Download desktop <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href="/login">Open Rimeward <span aria-hidden="true">→</span></a>
        </div>
        <p class="product-meta">Apple Silicon macOS · Windows · Linux · Open source</p>
      </div>
      <WardDemo />
    </section>

    <nav class="workspace-index" aria-label="Explore Rimeward features">
      <a href="#wards">Wards</a><a href="#projects">Projects</a><a href="#rime">Rime</a><a href="#everyday">Everyday tools</a><a href="#leylines">Leylines</a><a href="#remote">Remote access</a>
    </nav>

    <section class="product-section" id="wards" aria-labelledby="wards-title">
      <div class="product-section-heading">
        <p class="product-eyebrow">Build a page that fits</p>
        <h2 id="wards-title">A ward for the work at hand.</h2>
        <p>Add the tools you need. Resize them, move them, or give a different part of your day its own page. Wards stay useful on their own; Leylines let them work together.</p>
      </div>
      <div class="ward-collection">
        {wardExamples.map(([type, description]) => <article><span class="ward-icon" aria-hidden="true">{type === 'agent' ? <Icon id="rime" /> : <Fragment set:html={iconSvg('lucide', ICONS[CATALOG[type].icon][1]) ?? ''} />}</span><div><h3>{CATALOG[type].title}</h3><p>{description}</p></div></article>)}
      </div>
    </section>

    <section class="product-section" id="projects" aria-labelledby="projects-title">
      <div class="product-section-heading">
        <p class="product-eyebrow">A home for what you’re building</p>
        <h2 id="projects-title">From the first idea<br />to the last command.</h2>
        <p>Open a local project. Edit files, see diagnostics, run a terminal, and ask Rime to help. Your project folders stay on their computer.</p>
      </div>
      <figure class="product-shot project-workspace"><a href="/projects/rimeward-editor.webp" target="_blank" aria-label="View the project workspace screenshot at full size (opens a new tab)"><img src="/projects/rimeward-editor.webp" width="1248" height="660" alt="Rimeward’s editor and Rime wards working side by side in the Orbital demonstration project" loading="lazy" /></a><figcaption>Editor + Rime · Current interface with demo content</figcaption></figure>
      <div class="product-grid">
        <article class="product-card"><h3>Edit with confidence</h3><p>Explore files, spot problems, format code, and recover unfinished work in the editor.</p></article>
        <article class="product-card"><h3>Use your own tools</h3><p>Run native terminal sessions, or work with your installed Codex and Claude Code CLIs.</p></article>
        <article class="product-card"><h3>Keep projects local</h3><p>Your files and shells belong to their computer. Reach the live workspace through an approved server connection.</p></article>
      </div>
    </section>

    <section class="product-section" aria-label="Rime and everyday tools">
      <div class="product-split story-grid">
        <article id="rime">
          <div class="product-section-heading">
            <p class="product-eyebrow">Meet Rime</p><h2>An agent with<br />your workspace in reach.</h2>
            <p>Talk through an idea, work with files, or follow a task as it unfolds. Rime keeps conversation history, memory, and a visible trail of its actions.</p>
          </div>
          <figure class="product-shot"><a href="/projects/rimeward-chat.webp" target="_blank" aria-label="View the Rime conversation screenshot at full size (opens a new tab)"><img src="/projects/rimeward-chat.webp" width="1088" height="900" alt="A Rime conversation with a demonstration project request, tool activity and a structured reply" loading="lazy" /></a><figcaption>See the conversation and the work behind it.</figcaption></figure>
          <p class="product-caption">Use ChatGPT / Codex, OpenRouter, the OpenAI API, or an OpenAI-compatible endpoint. Connect your provider or local model.</p>
        </article>
        <article id="everyday">
          <div class="product-section-heading">
            <p class="product-eyebrow">More than a project</p><h2>Your day belongs<br />here, too.</h2>
            <p>Put notes, mail, calendars, routines, Notion, and service health on the pages where you need them. Connect the services you use.</p>
          </div>
          <figure class="product-shot"><a href="/projects/rimeward-notes.webp" target="_blank" aria-label="View the everyday workspace screenshot at full size (opens a new tab)"><img src="/projects/rimeward-notes.webp" width="1248" height="772" alt="Rimeward’s everyday tools with a demonstration planning note and personal workspace" loading="lazy" /></a><figcaption>A page for the details that make a day.</figcaption></figure>
          <p class="product-caption">Choose layouts, themes, fonts, icons, and backgrounds. A ward is a tool on a page; arrange them around the way you work.</p>
        </article>
      </div>
    </section>

    <section class="product-section product-split leyline-section" id="leylines" aria-labelledby="leylines-title">
      <div class="product-section-heading">
        <p class="product-eyebrow">Make the connections</p><h2 id="leylines-title">One action.<br />A little further.</h2>
        <p>Draw Leylines between your tools. A button starts a routine. A service incident asks Rime to investigate. An event becomes the next step in your workflow.</p>
        <a class="product-text-link" href={`${source}/wiki/Desktop-Workspace`}>Explore your workspace <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="leyline-example">
        <div class="leyline-node"><Icon id="host" /><div><span>Event</span><strong>Service incident</strong></div></div>
        <div class="leyline-connection" aria-hidden="true"><span>Leyline</span></div>
        <div class="leyline-node"><Icon id="rime" /><div><span>Action</span><strong>Ask Rime to investigate</strong></div></div>
        <figcaption class="product-caption">Example connection between two wards.</figcaption>
      </figure>
    </section>

    <section class="product-section product-split browser-story" aria-labelledby="browser-title">
      <figure class="product-shot"><img src="/projects/rimeward-workspace.webp" width="1360" height="900" alt="Two demonstration pages open side by side in Rimeward’s browser workspace" loading="lazy" /><figcaption>Browse beside the rest of your work.</figcaption></figure>
      <div class="product-section-heading">
        <p class="product-eyebrow">Stay in context</p><h2 id="browser-title">The browser is<br />part of the workspace.</h2>
        <p>Keep real Chromium sessions alongside your notes and projects. Manage downloads and extensions, keep logins on their owning computer, and ask Rime about the page.</p>
      </div>
    </section>

    <section class="product-section product-split remote-story" id="remote" aria-labelledby="remote-title">
      <div class="product-section-heading">
        <p class="product-eyebrow">Pick up elsewhere</p><h2 id="remote-title">Your computer’s tools.<br />Within reach.</h2>
        <p>Pair a Rimeward server with your desktop. Use its live editor and terminals from a browser or phone, or add a Remote Desktop ward to reach the screen.</p>
        <p class="product-caption">The desktop stays on and does the work. Project folders remain local; shared Rime history and tool output can pass through your trusted server.</p>
        <a class="product-text-link" href={`${source}/wiki/Remote-Access`}>Set up remote access <span aria-hidden="true">↗</span></a>
      </div>
      <div class="remote-panel">
        <div class="remote-copy"><Icon id="host" /><h3>Same workspace.<br />Smaller screen.</h3><p>Keep working with the computer that owns the project.</p><span class="remote-status">Desktop connected</span></div>
        <figure class="phone-shot"><img src="/projects/rimeward-phone.webp" width="390" height="844" alt="The desktop-owned Orbital project editor viewed on a phone-sized screen" loading="lazy" /><figcaption>Phone view · Demo workspace</figcaption></figure>
      </div>
    </section>

    <p class="product-caption demo-note">Screenshots show disposable demonstration workspaces. Features depend on your release, platform, model provider, and connected services.</p>
    <section class="product-cta" aria-labelledby="download-title">
      <p class="product-eyebrow">Start right here</p><h2 id="download-title">Make room for your work.</h2>
      <p>The desktop bundles Node and Chromium. Start on one computer; connect a server when you want remote access.</p>
      <div class="product-actions"><a class="product-button" href={download}>Download Rimeward <span aria-hidden="true">↗</span></a><a class="product-button secondary" href={`${source}/wiki/Desktop-Setup`}>Desktop guide <span aria-hidden="true">↗</span></a></div>
      <p class="product-meta">Model access uses your own provider connection.</p>
      <p><a class="product-text-link" href="/guides/rimeward-first-workspace">Build your first workspace <span aria-hidden="true">→</span></a></p>
      <a class="product-text-link" href={source}>View on GitHub <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</MarketingLayout>

<style>
  .rimeward-page .product-hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 3rem; padding-bottom: 3rem; }
  .rimeward-page .product-intro { max-width: 52rem; margin: auto; text-align: center; }
  .rimeward-page :global(.product-logo) { margin: 0 auto 1.5rem; }
  .rimeward-page .product-lead { max-width: 38rem; margin: auto; }
  .rimeward-page .product-hero .product-actions { justify-content: center; }
  .ward-collection { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .ward-collection article { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; border: 1px solid #23394e; border-radius: 0.75rem; background: #0a1725; }
  .ward-icon { display: flex; width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: #9be7ff; }
  .ward-icon :global(svg), .ward-icon :global([data-icon]) { width: 100%; height: 100%; }
  .ward-collection h3 { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.3rem; }
  .ward-collection p { color: #8fa8c0; font-size: 0.75rem; line-height: 1.5; }
  .project-workspace { margin-bottom: 2rem; }
  .workspace-index { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; padding: 0 0 2rem; color: #b3c8dc; font-size: 0.8rem; }
  .workspace-index a:hover { color: #9be7ff; }
  .product-shot { margin: 0; min-width: 0; }
  .product-shot a { display: block; border-radius: 0.75rem; }
  .product-shot img { display: block; width: 100%; height: auto; border: 1px solid #2c4860; border-radius: 0.75rem; background: #0a1725; box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.18); }
  .product-shot figcaption { color: #8fa8c0; font-size: 0.75rem; text-align: center; margin-top: 1rem; }
  .story-grid { gap: 2.5rem; }
  .story-grid .product-section-heading { min-height: 13rem; margin-bottom: 1.75rem; }
  .leyline-section, .browser-story, .remote-story { align-items: center; gap: 3rem; }
  .leyline-section .product-section-heading, .browser-story .product-section-heading, .remote-story .product-section-heading { margin: 0; }
  .leyline-example { padding: 2.5rem; border: 1px solid #2c4860; border-radius: 1rem; background: #0b1828; }
  .leyline-node { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; border: 1px solid #3f6a81; border-radius: 0.6rem; background: #11283c; }
  .leyline-node :global([data-icon]) { width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: #9be7ff; font-size: 1.25rem; }
  .leyline-node span { display: block; font-size: 0.65rem; color: #9bbcd0; margin-bottom: 0.4rem; }
  .leyline-node strong { font-size: 0.9rem; font-weight: 500; }
  .leyline-connection { position: relative; height: 4rem; margin-left: 2rem; border-left: 1px solid #6fdcff; }
  .leyline-connection::after { content: ''; position: absolute; left: -4px; bottom: 0; width: 7px; height: 7px; border-radius: 50%; background: #9be7ff; }
  .leyline-connection span { display: block; padding: 1.4rem 0 0 1rem; color: #8fa8c0; font-size: 0.7rem; }
  .remote-panel { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 1.5rem; padding: 2rem 1.5rem 1.5rem 2rem; border: 1px solid #2c4860; border-radius: 1rem; background: radial-gradient(ellipse at 70% 30%, #143b50, #0b1828 75%); }
  .remote-copy :global([data-icon]) { width: 1.5rem; height: 1.5rem; color: #9be7ff; font-size: 1.25rem; margin-bottom: 1.25rem; }
  .remote-copy h3 { font-size: 1.2rem; line-height: 1.35; font-weight: 500; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .remote-copy p { color: #b3c8dc; font-size: 0.85rem; line-height: 1.7; }
  .remote-status { display: block; font-size: 0.65rem; color: #a7dbca; margin-top: 1.5rem; }
  .remote-status::before { content: ''; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #a7dbca; margin-right: 0.5rem; }
  .phone-shot img { width: 100%; height: auto; border: 1px solid #436079; border-radius: 1rem; }
  .phone-shot figcaption { color: #a8c3d7; text-align: center; font-size: 0.6rem; margin-top: 0.75rem; }
  .demo-note { text-align: center; max-width: 44rem; margin: 0 auto; }
  @media (max-width: 900px) { .remote-panel { padding: 1.5rem; gap: 1rem; } .remote-copy h3 { font-size: 1rem; } }
  @media (max-width: 700px) {
    .ward-collection { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .ward-collection article { padding: 1rem; gap: 0.75rem; }
    .workspace-index { gap: 0.75rem 1.5rem; }
    .story-grid { gap: 3rem; }
    .story-grid .product-section-heading { min-height: 0; }
    .leyline-section, .browser-story, .remote-story { gap: 2rem; }
    .browser-story .product-section-heading { grid-row: 1; }
    .leyline-example { padding: 1.5rem; }
    .remote-copy h3 { font-size: 1.1rem; }
  }
</style>
