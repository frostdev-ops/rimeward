---
import { runtimeNavigation } from '../../lib/dev/navigation.ts';
import { isDesktop } from '../../lib/dev/runtime.ts';
import AppLayout from '../../layouts/AppLayout.astro';
import Ward from '../../components/dashboard/Ward.astro';
import Icon from '../../components/Icon.astro';
import ComposeDialog from '../../components/dashboard/ComposeDialog.astro';
import MailDialog from '../../components/dashboard/MailDialog.astro';
import AddWardDialog from '../../components/dashboard/AddWardDialog.astro';
import AgentDialog from '../../components/dashboard/AgentDialog.astro';
import BrowserDialog from '../../components/dashboard/BrowserDialog.astro';
import RemoteDesktopDialog from '../../components/dashboard/RemoteDesktopDialog.astro';
import NoteDialog from '../../components/dashboard/NoteDialog.astro';
import NotebookDialog from '../../components/dashboard/NotebookDialog.astro';
import WardThemeDialog from '../../components/dashboard/WardThemeDialog.astro';
import { getDashboard, getPages } from '../../lib/dashboard.ts';
import { pageOf } from '../../lib/wards.ts';
import { getGraph, getRuns } from '../../lib/logic-engine.ts';
import { getSetting } from '../../lib/settings.ts';
import { syncRime } from '../../lib/agent/sync.ts';

const userId = Astro.locals.user!.userId;
if (isDesktop()) {
  await syncRime(userId);
  const { getDb } = await import('../../lib/db.ts');
  Astro.locals.user!.theme = (getDb().prepare('SELECT theme FROM users WHERE id=?').get(userId) as { theme: string | null }).theme;
}
const layout = getDashboard(userId);
const pages = getPages(userId);
// Entrance stagger per PAGE: an off-stage card (display:none) starts its CSS
// entrance the first time its page shows, so each page cascades from 80ms.
const seen = new Map<string, number>();
const tops = layout
  .filter((w) => !w.in)
  .map((w) => {
    const page = pageOf(w, pages);
    const i = seen.get(page) ?? 0;
    seen.set(page, i + 1);
    return { w, page, delay: 80 + i * 30 };
  });
// Alert banner scope — see renderAlerts in scripts/app/status.ts.
const alertMode = getSetting(`alerts:${userId}`) ?? 'visible';
// <-escape so a user-supplied title can never close the script tag.
const layoutJson = JSON.stringify(layout).replaceAll('<', '\\u003c');
const pagesJson = JSON.stringify(pages).replaceAll('<', '\\u003c');
const logicJson = JSON.stringify({
  graph: getGraph(userId, layout),
  runs: getRuns(userId),
  isAdmin: Astro.locals.user!.role === 'admin',
}).replaceAll('<', '\\u003c');
---

<AppLayout title="Rimeward" fonts={layout.map((w) => w.theme?.font)}>
  <main class="mx-auto max-w-7xl px-4 py-6">
    <div id="alerts" data-mode={alertMode}></div>
    <div id="sse-banner" class="banner banner-warn hidden">Live feed lost — retrying…</div>

    <div class="mb-3 flex flex-wrap items-center justify-end gap-2" id="wd-toolbar">
      <button id="dev-open-project" class="btn text-xs" type="button" aria-label="Open project" hidden={!isDesktop()}><Icon id="folder" /> Open project</button>
      <span class="mr-auto truncate text-xs text-ink-faint" data-tb-hint>Right-click a ward for options</span>
      <button type="button" class="btn px-2 py-1 text-xs hidden" data-tb="undo" aria-label="Undo" title="Undo"><Icon id="undo" /><span class="tb-label">Undo</span></button>
      <button type="button" class="btn px-2 py-1 text-xs hidden" data-tb="add" aria-label="Add ward" title="Add ward"><Icon id="plus" /><span class="tb-label">Add ward</span></button>
      <button type="button" class="btn px-2 py-1 text-xs hidden" data-tb="cancel" aria-label="Cancel" title="Cancel"><Icon id="close" /><span class="tb-label">Cancel</span></button>
      <button type="button" class="btn px-2 py-1 text-xs" data-tb="logic" aria-label="Leylines" title="Leylines"><Icon id="route" /><span class="tb-label">Leylines</span></button>
      <button type="button" class="btn px-2 py-1 text-xs" data-tb="edit" aria-label="Edit" title="Edit"><Icon id="pen" /><span class="tb-label">Edit</span></button>
    </div>

    <nav class="app-pages" id="wd-pages" aria-label="Pages" hidden={pages.length < 2}>
      {pages.map((p) => (
        <button type="button" class="app-page" data-page-tab={p.id}>{p.title}</button>
      ))}
      <button type="button" class="app-page app-page-add" data-page-add title="Add page" aria-label="Add page">+</button>
    </nav>

    <div class="wd-grid mb-8" id="wd-grid">
      {tops.map(({ w, page, delay }) => <Ward w={w} layout={layout} page={page} enterDelay={delay} />)}
    </div>
  </main>

  <MailDialog />
  <ComposeDialog />
  <AddWardDialog />
  <AgentDialog />
  <BrowserDialog />
  <RemoteDesktopDialog />
  <NoteDialog />
  <NotebookDialog />
  <WardThemeDialog />

  <script type="application/json" id="layout-data" set:html={layoutJson} />
  <script type="application/json" id="pages-data" data-active-page={runtimeNavigation(userId).activePage} set:html={pagesJson} />
  <script type="application/json" id="logic-data" set:html={logicJson} />

  <script>
    import '../../scripts/app/index.ts';
  </script>
</AppLayout>
