---
import { config } from '../lib/app-config.ts';
import { identityConnectors } from '../lib/identity.ts';
import ValleyLayout from '../layouts/ValleyLayout.astro';
import { userCount } from '../lib/users.ts';
import { secret } from '../lib/secrets.ts';

// A fresh install has no row that could log in; the CLI is where the first one comes from.
const noUsers = userCount() === 0;
const google = config('GOOGLE_SSO_ENABLED')==='true' && !!secret('GOOGLE_CLIENT_ID');

const err = Astro.url.searchParams.get('err');
const MESSAGES: Record<string, string> = {
  '1': 'Incorrect email or password.',
  throttled: 'Too many attempts. Try again in a few minutes.',
  sso: 'Google sign-in failed. Try again.',
  invite: 'That Google account is not invited. Ask the admin for an invite.',
  'sso-unconfigured': 'Google sign-in is not configured yet.',
};
const message = err ? (MESSAGES[err] ?? 'Sign-in failed.') : null;
---

<ValleyLayout title="Sign in — Rimeward">
  <div class="valley-card">
    {
      message && (
        <p id="form-error" role="alert" tabindex="-1" class="banner banner-err mb-0">
          {message}
        </p>
      )
    }

    {
      noUsers && (
        <p class="banner banner-info mb-0">
          No users yet. Create the first one on the server:
          <code>node bin/rimeward.mjs users create you@example.com --admin</code>
        </p>
      )
    }

    {
      google && (
        <>
          <a href="/api/auth/google" class="login-google">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.39 3.62v3h3.87c2.26-2.09 3.57-5.17 3.57-8.81Z" />
              <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.93-2.91l-3.87-3c-1.07.72-2.44 1.14-4.06 1.14-3.12 0-5.77-2.11-6.71-4.95H1.29v3.1A12 12 0 0 0 12 24Z" />
              <path fill="#FBBC05" d="M5.29 14.28a7.2 7.2 0 0 1 0-4.56v-3.1H1.29a12 12 0 0 0 0 10.76l4-3.1Z" />
              <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.6 4.58 1.79l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.29 6.62l4 3.1C6.23 6.88 8.88 4.77 12 4.77Z" />
            </svg>
            Sign in with Google
          </a>

          <div class="login-divider">
            <span></span>
            or with a password
            <span></span>
          </div>
        </>
      )
    }

    {config('PASSWORD_LOGIN')==='true'&&<form method="post" action="/api/login" class="valley-form">
      <div class="valley-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="username" />
      </div>
      <div class="valley-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="valley-submit">Sign in</button>
    </form>}
  </div>

  <div class="valley-foot">{identityConnectors().filter(c=>c.enabled&&c.id!=='google').map(c=><p><a href={`/api/auth/identity/${c.id}`} class="link">Sign in with {c.name}</a></p>)}<a class="link" href="/recover">Recover account access</a>{config('REGISTRATION_POLICY')!=='invite'&&<p><a class="link" href="/register">Create an account</a></p>}</div>
</ValleyLayout>

<style>
  /* The two SSO-only bits, page-scoped: nothing else shows a provider button.
     Astro scopes selectors but NOT keyframe names, so valley-rise (global,
     frost.css) is what these animate with. */
  .login-google {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(111 220 255 / 0.22);
    background: rgb(232 242 250 / 0.06);
    font-size: 0.875rem;
    font-weight: 600;
    color: #e8f2fa;
    transition: background-color 0.2s, border-color 0.2s, transform 0.15s;
    animation: valley-rise 0.5s var(--fd-spring) 0.18s both;
  }
  .login-google:hover,
  .login-google:focus-visible {
    background: rgb(232 242 250 / 0.12);
    border-color: rgb(111 220 255 / 0.45);
  }
  .login-google:active {
    transform: translateY(1px);
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5c7189;
    animation: valley-rise 0.5s var(--fd-spring) 0.24s both;
  }
  .login-divider span {
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, transparent, rgb(111 220 255 / 0.25), transparent);
  }
</style>
