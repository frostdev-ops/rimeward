---
import '../../styles/development.css';
import Icon from '../../components/Icon.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import {isDesktop} from '../../lib/dev/runtime.ts';
import {deviceAuthorization,approveDeviceAuth,limitDeviceAuth} from '../../lib/dev/device-auth.ts';
if(isDesktop())return Astro.redirect('/desktop/start');
Astro.response.headers.set('cache-control','no-store');
Astro.response.headers.set('referrer-policy','same-origin');
const code=Astro.url.searchParams.get('code')??'';
let grant, error='',done=false,declined=false;
try {
  limitDeviceAuth('review:'+Astro.locals.user!.userId,30);
  grant=deviceAuthorization(code);
  if(Astro.request.method==='POST'){
    const form=await Astro.request.formData();
    declined=form.get('decision')==='deny';
    if(!['allow','deny'].includes(String(form.get('decision'))))throw new Error('Choose Allow or Decline.');
    approveDeviceAuth(code,Astro.locals.user!.userId,!declined);done=true;
  }
}catch(e){error=(e as Error).message;}
---
<AppLayout title="Connect a desktop — Rimeward" search={false}>
  <main class="setup-approval-page">
    <section class="setup-card">
      <span class="setup-card-icon"><Icon id={done ? "sparkle" : "route"} /></span>
      <p class="setup-eyebrow">RIMEWARD · CONNECT A DESKTOP</p>
      <h1 class="text-2xl font-semibold tracking-tight">{done?(declined?'Connection declined':'Desktop approved'):'Connect this desktop?'}</h1>
      {error?<p role="alert" class="banner banner-err">{error}</p>:done?<><p>Return to the Rimeward app to continue.</p><a class="btn" href="rimeward://oauth/complete">Return to Rimeward</a><a class="btn" href="/dash">Open my dashboard</a></>:<>
        <p><strong>{grant!.name}</strong> wants to connect to your Rimeward account, <strong>{Astro.locals.user!.email}</strong>.</p>
        <p>This connects Rime’s provider access, chat history, memories, skills, and agent files, with a local copy for offline work. It also lets you remotely control this desktop while it is online. Project folders stay on the desktop; code excerpts and attachments shared with Rime travel with its chats.</p>
        <p>Confirm this matches the request you just started in the app: <strong class="setup-approval-code">{code}</strong></p>
        <form method="post" class="flex gap-3"><button class="btn-primary" name="decision" value="allow">Allow this desktop</button><button class="btn" name="decision" value="deny">Decline</button></form>
      </>}
    </section>
  </main>
</AppLayout>
