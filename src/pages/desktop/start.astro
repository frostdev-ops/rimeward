---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import {isDesktop} from '../../lib/dev/runtime.ts';
if(!isDesktop())return new Response('Desktop setup is available in the app.',{status:404});
Astro.response.headers.set('cache-control','no-store');
---
<AppLayout title="Welcome to Rimeward" search={false}>
  <main class="desktop-setup" data-setup={Astro.url.searchParams.has('setup')?'1':'0'} data-step="connect">
    <header class="setup-intro">
      <p class="setup-eyebrow"><span></span> YOUR WORKSPACE, CONNECTED</p>
      <h1>Make yourself at home.</h1>
      <p>Bring your Rimeward dashboard with you.<br />Build on this desktop, and pick up from anywhere.</p>
    </header>
    <p id="setup-status" role="status" aria-live="polite"></p>
    <section id="setup-connected" hidden class="setup-connected" aria-label="Connections"></section>
    <div class="setup-options">
      <section class="setup-card setup-primary" id="setup-connect">
        <span class="setup-card-icon"><Icon id="route" /></span>
        <div><p class="setup-eyebrow">ALREADY USE RIMEWARD?</p><h2>Bring your dashboard.</h2></div>
        <p>Connect your server to open your existing wards, conversations, and integrations.</p>
        <ol class="setup-progress" aria-label="Connection progress">
          <li data-step="connect" aria-current="step"><span>1</span> Connect</li>
          <li data-step="approve"><span>2</span> Approve</li>
          <li data-step="ready"><span>3</span> Ready</li>
        </ol>
        <form id="setup-form">
          <label for="setup-server">Rimeward server address</label>
          <input id="setup-server" class="input" name="server" type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" aria-describedby="setup-address-help" placeholder="rimeward.example.com" required />
          <p id="setup-address-help" class="setup-help">Sign in securely in your browser. No tokens to copy.</p>
          <button class="btn-primary" id="setup-submit" aria-label="Continue in browser" type="submit">Continue in browser <Icon id="right" /></button>
        </form>
        <div id="setup-wait" hidden>
          <p>Approve this desktop in your browser.</p><p class="setup-help">Match this request code:</p><strong id="setup-code"></strong>
          <div class="flex flex-wrap gap-2"><button class="btn" id="setup-reopen" type="button">Open browser again</button><button class="btn" id="setup-cancel" type="button">Cancel connection</button></div>
          <a id="setup-link" target="_blank" rel="noopener noreferrer">Open approval page <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="setup-card">
        <span class="setup-card-icon"><Icon id="code" /></span>
        <div><p class="setup-eyebrow">READY TO BUILD?</p><h2>Start right here.</h2></div>
        <p>Your files, terminals, and agents. One workspace on your computer, ready whenever you are.</p>
        <ul class="setup-features">
          <li><Icon id="folder" /><span><strong>A home for your projects</strong><small>Open a folder or create something new.</small></span></li>
          <li><Icon id="code" /><span><strong>Your tools, together</strong><small>Editor, terminal, browser, and agents.</small></span></li>
          <li><Icon id="sparkle" /><span><strong>Works on its own</strong><small>Keep working when your server is offline.</small></span></li>
        </ul>
        <div class="setup-local-actions"><button class="btn" id="setup-project" aria-label="Open or create a project" type="button"><Icon id="plus" /> Open or create a project</button><button class="setup-text-button" id="setup-local" type="button">Continue without connecting <span aria-hidden="true">→</span></button></div>
      </section>
    </div>
    <section class="setup-card" aria-labelledby="computer-control-title">
      <h2 id="computer-control-title">Remote Desktop access</h2>
      <p>Your signed-in account can view and control this computer when OS permissions allow it. Viewing starts without input control. Rime screenshots join its conversation; human viewing does not.</p>
      <form id="computer-control-form">
        <label><input type="checkbox" id="computer-control-enabled" /> Enable remote access (resume a local Stop)</label>
        <p class="setup-help">Stop immediately from the Rimeward tray menu. File and terminal tools keep their existing permissions.</p>
        <p id="computer-control-permissions" class="setup-help"></p>
        <button type="button" class="btn" data-macos-permissions hidden>Set up Mac permissions…</button>
        <button type="submit" class="btn">Save control settings</button>
        <p id="computer-control-status" role="status" aria-live="polite"></p>
      </form>
      <div id="computer-control-approvals" class="flex flex-col gap-2"></div>
      <div id="computer-access-policies" class="flex flex-col gap-3"></div>
    </section>
    <p class="setup-footnote">Rime’s chats, memories, and agent files stay in sync. Project folders stay on this computer.<br />Your pages, settings, and Rime are one shared workspace.</p>
  </main>
  <script>import '../../scripts/app/desktop-setup.ts';</script>
</AppLayout>
