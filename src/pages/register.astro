---
import ValleyLayout from '../layouts/ValleyLayout.astro';
import { registerAccount, limitAccountAction } from '../lib/account-access.ts';
import { clientIp } from '../lib/net-guard.ts';
let error='', done=false;
Astro.response.headers.set('Cache-Control','no-store');
if(Astro.request.method==='POST')try{
  limitAccountAction('register:'+clientIp(Astro.request, Astro.clientAddress));
  const form=await Astro.request.formData();
  await registerAccount(String(form.get('email')??''),String(form.get('password')??''));done=true;
}catch(e){error=(e as Error).message;}
---
<ValleyLayout title="Create account — Rimeward">
  <div class="valley-card">
    <h1 class="valley-title">Create your account</h1>
    {error&&<p id="form-error" role="alert" tabindex="-1" class="banner banner-err mb-0">{error}</p>}
    {done?<p role="status">Check your email to continue. An administrator may need to approve your account.</p>:<form method="post" class="valley-form">
      <div class="valley-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="username" />
      </div>
      <div class="valley-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="12" maxlength="1024" required autocomplete="new-password" />
      </div>
      <button type="submit" class="valley-submit">Create account</button>
    </form>}
  </div>

  <div class="valley-foot"><a href="/login" class="link">Sign in</a></div>
</ValleyLayout>
