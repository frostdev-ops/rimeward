---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import RimewireDemo from '../components/marketing/RimewireDemo.astro';
import '../styles/products.css';

const source = 'https://github.com/frostdev-ops/rimewire';
---

<MarketingLayout title="Rimewire — Your agents. One shared picture." description="A local project board for your agents, plans, progress, blockers, and review handoffs. Rimewire by Frostdev." path="/rimewire" image="/projects/rimewire-board-progress.webp">
  <div class="product-page rimewire-page">
    <section class="product-hero product-hero-demo" aria-labelledby="rimewire-title">
      <div class="product-intro">
        <p class="product-eyebrow">Rimewire · Agent coordination</p>
        <img class="product-logo" src="/projects/rimewire.webp" width="900" height="301" alt="Rimewire" />
        <h1 class="product-title" id="rimewire-title">Your agents.<br />One shared picture.</h1>
        <p class="product-lead">Keep plans, progress, and handoffs together. A local project board that your agents update and you can follow.</p>
        <div class="product-actions">
          <a class="product-button" href={`${source}#install`}>Get started <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href={source}>View source <span aria-hidden="true">↗</span></a>
        </div>
        <p class="product-meta">Local data · MCP + CLI · Open source</p>
      </div>
      <RimewireDemo />
    </section>

    <section class="product-section" aria-labelledby="board-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Keep the work in view</p>
        <h2 id="board-heading">Know what moved.<br />And what needs you.</h2>
        <p>Follow work packages, dependencies, branches, and recent updates across sessions and Git worktrees.</p>
      </div>

      <div class="product-grid">
        <article class="product-card"><span class="card-number">01</span><h3>Start with your tracker</h3><p>Use a Markdown plan with your own package IDs, phases, statuses, and branch conventions.</p></article>
        <article class="product-card"><span class="card-number">02</span><h3>Leave a useful trail</h3><p>Agents post progress, blockers, and review handoffs through MCP or the local CLI.</p></article>
        <article class="product-card"><span class="card-number">03</span><h3>Make completion explicit</h3><p>Post <code>ready</code> after work and checks pass. Later progress or a blocker reopens the package.</p></article>
      </div>
    </section>

    <section class="product-section product-split" aria-labelledby="local-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Built around your checkout</p>
        <h2 id="local-heading">Local by design.<br />Shared across the work.</h2>
        <p>Each checkout keeps its own update journal. Rimewire brings those journals into one worktree-aware board, served on your machine.</p>
        <a class="product-text-link" href={`${source}/blob/main/docs/CONFIGURATION.md`}>Make the board yours <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-panel local-panel">
        <div class="checkout-flow" aria-label="Checkout-local journals feed one shared board">
          <div class="checkout-node"><span class="node-label">Main checkout</span><code>tracker.md</code></div>
          <div class="checkout-node"><span class="node-label">Worktree A</span><code>progress → journal</code></div>
          <div class="checkout-node"><span class="node-label">Worktree B</span><code>blocker → journal</code></div>
          <div class="shared-node"><span class="node-label">One local board</span><strong>Plans + updates + branches</strong></div>
        </div>
        <p class="product-caption">No cloud service or model API required. Journals stay gitignored; configuration and trackers can be versioned.</p>
      </div>
    </section>

    <section class="product-section" aria-labelledby="setup-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Fit your workflow</p>
        <h2 id="setup-heading">Bring your harness.</h2>
        <p>Use Rimewire with Claude Code, Codex, OpenCode, or Pi. The bundled setup skill adapts the board to your project.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><span class="card-number">01 / Install</span><h3>Build from source</h3><p>Start with Node.js 24+ and npm. Follow the install guide for your harness.</p><a class="product-text-link" href={`${source}#install`}>Installation guide <span aria-hidden="true">↗</span></a></article>
        <article class="product-card"><span class="card-number">02 / Configure</span><h3>Run the setup skill</h3><p>Ask your agent to run <code>rimewire-setup</code>. It surveys your tracker and adds project instructions.</p></article>
        <article class="product-card"><span class="card-number">03 / Follow</span><h3>Open your board</h3><p>Ask for <code>board_url</code>. Watch the work and let your agents keep the picture current.</p></article>
      </div>
    </section>

    <section class="product-cta">
      <p class="product-eyebrow">Rimewire by Frostdev</p>
      <h2>Keep everyone on the same page.</h2>
      <a class="product-button" href={`${source}#install`}>Get started <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</MarketingLayout>

<style>
  .rimewire-page { --product-accent: #99dce5; }
  .card-number { display: block; color: #9bd7e1; font-size: 0.7rem; letter-spacing: 0.06em; margin-bottom: 1rem; }
  code { color: #c0e6ec; font-size: 0.88em; }
  .local-panel { padding: 1.75rem; }
  .checkout-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem; }
  .checkout-node { position: relative; text-align: center; padding: 1.1rem 0.4rem; border: 1px solid #345064; border-radius: 0.5rem; background: #102235; }
  .node-label { display: block; color: #bfd4e5; font-size: 0.7rem; margin-bottom: 0.6rem; }
  .checkout-node code { font-size: 0.61rem; }
  .checkout-node::after { content: ''; position: absolute; top: 100%; left: 50%; height: 1.35rem; width: 1px; background: #4f8897; }
  .shared-node { grid-column: 1 / -1; margin-top: 0.65rem; padding: 1.25rem; text-align: center; border: 1px solid #4f8897; border-radius: 0.5rem; background: linear-gradient(120deg, #173347, #102236); }
  .shared-node strong { font-size: 0.9rem; font-weight: 500; color: #d2eff3; }
  .local-panel .product-caption { margin-top: 1.5rem; line-height: 1.75; }
  @media (max-width: 800px) {
    .checkout-flow { gap: 0.45rem; }
    .local-panel { padding: 1.25rem; }
  }
  @media (max-width: 600px) {
    .checkout-flow { grid-template-columns: 1fr; gap: 0.8rem; }
    .checkout-node::after { height: 0.8rem; }
    .shared-node { margin-top: 0; }
  }
</style>
