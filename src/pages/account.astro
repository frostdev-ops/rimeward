    /* ---------------------------------------------------------- panels */
    /* Panels animate on every show because toggling [hidden] takes them
       through display:none, which restarts a CSS animation. The direction
       follows the tab order (--acct-dir, set by the tab script), and the
       cards inside cascade in. Nothing left filling forwards over the layout. */
    .acct-panel {
      animation: fd-acct-in 0.3s var(--fd-ease) backwards;
      /* A deep link (#background) jumps here before the script runs — keep
         the section clear of the sticky header + tab strip. */
