      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    /* ---------------------------------------------------------- fields */
    /* Every knob row is one grid: labels line up on the same baseline no
       matter whether a slider, a select or a swatch sits under them. */
    .acct-grid {
