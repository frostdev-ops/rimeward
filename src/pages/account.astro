    /* The one accent pill, slid under whichever tab is current. It lives
       inside the scroller so it scrolls with the tabs. */
    .acct-ind {
      position: absolute;
      top: 3px;
      bottom: 3px;
      left: 0;
      width: var(--w, 0px);
      translate: var(--x, 0px) 0;
