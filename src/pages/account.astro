      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-ink-muted);
      scroll-snap-align: start;
      transition: color 0.2s var(--fd-ease);
    }
    @media (min-width: 640px) {
      .acct-tab {
        min-height: 2.25rem;
      }
    }
    .acct-tab:hover {
      color: var(--color-ink);
    }
    .acct-tab[aria-current] {
