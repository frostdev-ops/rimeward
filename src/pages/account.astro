    .acct-panel > .card:nth-child(2) { --i: 1; }
    .acct-panel > .card:nth-child(3) { --i: 2; }
    .acct-panel > .card:nth-child(4) { --i: 3; }
    .acct-panel > .card:nth-child(n + 5) { --i: 4; }
    @keyframes fd-acct-in {
      from {
        opacity: 0;
        translate: calc(var(--acct-dir, 1) * 18px) 0;
      }
    }
    @keyframes fd-acct-card {
      from {
