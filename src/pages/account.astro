  </style>

  {/* No JS: no tabs and no autosave, so show every section and let the
      remaining <noscript> submit buttons do the work. */}
  <noscript>
    <style is:inline>
      .acct-panel[hidden] { display: block !important; }
      .acct-nav { display: none; }
    </style>
  </noscript>

  {/* Inline and synchronous: the module below is deferred, and a deep link
      (#agent, #background) must not paint the first panel before switching. */}
  <script is:inline>
    (() => {
      const panels = [...document.querySelectorAll('.acct-panel')];
      const tabs = [...document.querySelectorAll('.acct-tab')];
      const strip = document.querySelector('.acct-tabs');
      const ind = document.querySelector('.acct-ind');
      const main = document.querySelector('main');
      // The accent pill under the current tab, and the tab scrolled into view.
      const place = (smooth) => {
        const cur = tabs.find((t) => t.hasAttribute('aria-current'));
        if (!cur || !ind) return;
        ind.style.setProperty('--x', cur.offsetLeft + 'px');
        ind.style.setProperty('--w', cur.offsetWidth + 'px');
        cur.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: smooth ? 'smooth' : 'instant' });
      };
      const show = (name, push) => {
        const target = panels.some((p) => p.id === name) ? name : panels[0].id;
        const from = tabs.findIndex((t) => t.hasAttribute('aria-current'));
        const to = tabs.findIndex((t) => t.dataset.tab === target);
        // Direction of the slide follows the tab order.
        if (main) main.style.setProperty('--acct-dir', to < from ? '-1' : '1');
        for (const p of panels) p.hidden = p.id !== target;
        for (const t of tabs) {
          if (t.dataset.tab === target) t.setAttribute('aria-current', 'page');
          else t.removeAttribute('aria-current');
        }
        place(push);
        if (push && location.hash.slice(1) !== target) history.replaceState(null, '', '#' + target);
      };
      // Edge fades: only on the side that has more strip to scroll to.
      const edges = () => {
        if (!strip) return;
        const l = strip.scrollLeft > 2;
        const r = strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 2;
        const v = l && r ? 'both' : l ? 'left' : r ? 'right' : '';
        if (v) strip.dataset.scroll = v;
        else delete strip.dataset.scroll;
      };
      strip?.addEventListener('scroll', edges, { passive: true });
      // Sticky offset = the app header's height, which is a theme knob.
      const header = document.querySelector('.app-header');
      const ro = new ResizeObserver(() => {
        if (header && main) main.style.setProperty('--acct-top', header.offsetHeight + 'px');
        place(false);
        edges();
      });
      if (header) ro.observe(header);
      if (strip) ro.observe(strip);
      // Web fonts land after first paint and change the tab widths.
      document.fonts?.ready.then(() => place(false));
      // Transitions only from the second placement on — the first is the SSR'd
      // position and must not slide in from 0.
      requestAnimationFrame(() => strip && (strip.dataset.ready = ''));
      // A hash may name a card INSIDE a panel (#notion) — resolve to the panel.
      const fromHash = () => {
        const h = location.hash.slice(1);
        if (!h) return '';
        const el = document.getElementById(h);
        return el ? (el.closest('.acct-panel') || {}).id || h : h;
      };
      show(fromHash(), false);
      for (const t of tabs) t.addEventListener('click', () => show(t.dataset.tab, true));
      addEventListener('hashchange', () => show(fromHash(), false));
    })();
  </script>

  <script>
    // Live theme preview: the SAME derivation the server uses (theme.ts),
    // applied to <html> on every input. Autosave then makes it permanent.
    // The background is part of it: data-bg + the knob vars are CSS, and the
    // three.js scene goes through the same applyBackground() the SSR boot uses.
    import { normalizeTheme, rollPreset, headerSceneConfig, sceneConfig, GFX_DEFAULTS, HDR_SCALE, PRESETS, PRESET_KNOBS, SCENES, type ThemePreset, type SceneId } from '../lib/theme.ts';
    import { gfxImpact, gfxLoad, type GfxKey } from '../lib/gfx.ts';
    import { applyThemeLive } from '../scripts/app/theme-live.ts';
    import { paintScenePreviews } from '../scripts/app/scene-thumbs.ts';
    import { readDesktopCheckpoint, saveDesktopState } from '../scripts/app/desktop-state.ts';

    // Renders each scene once into the pickers' <option data-preview>. Only
    // this page has scene selects, and a WebGL failure leaves them plain.
    paintScenePreviews();

    // ------------------------------------------------------------ autosave

    const readout = document.getElementById('acct-save')!;
    let clearFlash: number | undefined;

    function flash(msg: string, state: 'busy' | 'ok' | 'err'): void {
      readout.textContent = msg;
      readout.dataset.state = state;
      clearTimeout(clearFlash);
      if (state !== 'busy') clearFlash = window.setTimeout(() => delete readout.dataset.state, 1800);
    }

    /** POST a form without leaving the page. The routes answer 303 back to
     *  /account; `redirect: 'manual'` stops fetch from re-rendering this whole
     *  page (Notion calls included) for every slider nudge. Forms that have a
     *  real error path opt into following it, and read ?err= off the final URL. */
    const formState = (form: HTMLFormElement) => JSON.stringify([...new FormData(form)].map(([key, value]) =>
      [key, typeof value === 'string' ? value : value.name || value.size ? [value.name, value.size, value.lastModified] : null]));
    const settled = new Map([...document.forms].map(form => [form, formState(form)]));
    const saving = new Map<HTMLFormElement, Promise<boolean>>();
    const failed = new Set<HTMLFormElement>();
    function post(form: HTMLFormElement): Promise<boolean> {
      const work = (saving.get(form) ?? Promise.resolve()).then(async () => {
        const follow = form.hasAttribute('data-autosave-check');
        const state = formState(form);
        flash('Saving…', 'busy');
        // The attribute, not the property: a hidden <input name="action"> shadows
        // form.action with the element itself, and fetch(input) 404s.
        const res = await fetch(form.getAttribute('action')!, {
          method: 'POST',
          body: new FormData(form),
          redirect: follow ? 'follow' : 'manual',
          signal: AbortSignal.timeout(15000),
        }).catch(() => null);
        if (!res || res.status >= 400) { failed.add(form); flash('Not saved', 'err'); return false; }
        const err = follow ? new URL(res.url).searchParams.get('err') : null;
        if (err) { failed.add(form); flash(err.replace(/[-+]/g, ' '), 'err'); return false; }
        failed.delete(form);
        flash('Saved', 'ok');
        settled.set(form, state);
        onSaved?.(form);
        return true;
      });
      saving.set(form, work);
      void work.finally(() => { if (saving.get(form) === work) saving.delete(form); });
      return work;
    }

    /** Set by the theme block below — its undo stack records a step per save. */
    let onSaved: ((f: HTMLFormElement) => void) | null = null;

    const pending = new Map<HTMLFormElement, number>();
    function autosave(form: HTMLFormElement, delay = 0): void {
      clearTimeout(pending.get(form));
      pending.set(form, window.setTimeout(() => { pending.delete(form); void post(form); }, delay));
    }
    let checkpointTheme = () => {};
    window.addEventListener('fd:before-workspace-navigation', event => {
      (event as CustomEvent<{ waitUntil(p: Promise<unknown>): void }>).detail.waitUntil((async () => {
        for (const [form, timer] of pending) { clearTimeout(timer); void post(form); }
        pending.clear();
        const results = await Promise.all([...saving.values()]);
        if (failed.size || results.some(ok => !ok)) throw Error('Account changes could not be saved. Retry before relaunching.');
        if ([...settled].some(([form, state]) => form.isConnected && state !== formState(form)))
          throw Error('Save or finish editing your account forms before relaunching.');
        checkpointTheme();
      })());
    });

    // `change` (not `input`) everywhere but the theme form: it fires once a
    // select settles or a text field blurs, so a half-typed API key is never
    // stored, and an untouched field never fires at all.
    for (const form of document.querySelectorAll<HTMLFormElement>(
      '[action="/api/account/prefs"], [action="/api/account/agent"], [action="/api/notion/config"]'
    )) {
      // The codex sign-in forms are buttons, not settings — nothing to watch.
      if (form.querySelector('[name="pasted"]') || !form.querySelector('select, input:not([type="hidden"])')) continue;
      form.addEventListener('change', () => autosave(form));
    }

    // Clearing a key is a POST with an empty field; the route reads that as
    // "delete". It cannot be a submit button — Enter in the key field would
    // then wipe the key just typed.
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-clear-key]')) {
      btn.addEventListener('click', () => {
        const form = btn.form!;
        (form.elements.namedItem('key') as HTMLInputElement).value = '';
        void post(form);
      });
    }

    // The capture-page select fills the id field, which is what actually saves.
    document.getElementById('capture-select')?.addEventListener('change', (e) => {
      const field = document.getElementById('capturePageId') as HTMLInputElement;
      field.value = (e.target as HTMLSelectElement).value;
      field.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // --------------------------------------------------------- theme + bg

    const form = document.getElementById('theme-form') as HTMLFormElement | null;
    if (form) {
      const read = () => normalizeTheme(Object.fromEntries(new FormData(form)) as Record<string, unknown>);
      const set = (id: string, v: string | number) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
        if (el) el.value = String(v);
      };
      const setRadio = (name: string, v: string | number) => {
        // document, not form: the radios live in another panel and reach the form via form=.
        for (const r of document.querySelectorAll<HTMLInputElement>(`input[type=radio][name="${name}"]`)) r.checked = r.value === String(v);
      };
      /** The graphics knobs of one surface back to what its scene ships with. */
      const resetGfx = (p: 'bg' | 'hdr', sc: (typeof SCENES)[SceneId]) => {
        set(`th-${p}res`, sc.res);
        set(`th-${p}detail`, GFX_DEFAULTS.detail);
        setRadio(`${p}Fps`, GFX_DEFAULTS.fps);
      };

      // The impact meters and the load line (lib/gfx.ts) for both surfaces.
      const score = (cfg: ReturnType<typeof read>) => {
        const surfaces = { bg: sceneConfig(cfg), hdr: headerSceneConfig(cfg) };
        for (const el of document.querySelectorAll<HTMLElement>('[data-impact]')) {
          const [p, key] = el.dataset.impact!.split(':') as ['bg' | 'hdr', GfxKey];
          const sc = surfaces[p];
          if (!sc) continue;
          const im = gfxImpact(key, sc);
          for (const m of el.querySelectorAll<HTMLElement>('[data-meter]')) {
            const lvl = m.dataset.meter === 'gpu' ? im.gpu : im.battery;
            m.style.setProperty('--lvl', String(lvl));
            m.dataset.lvl = String(lvl);
          }
          el.querySelector<HTMLElement>('[data-note]')!.textContent = im.note ?? '';
        }
        for (const out of document.querySelectorAll<HTMLElement>('[data-load]')) {
          const sc = surfaces[out.dataset.load as 'bg' | 'hdr'];
          if (!sc) {
            out.textContent = '';
            continue;
          }
          const load = gfxLoad(sc, devicePixelRatio || 1);
          const band = load < 0.85 ? 'light' : load <= 1.5 ? 'default' : load <= 3 ? 'heavy' : 'hot';
          out.dataset.band = band;
          out.textContent = `≈ ${load < 1 ? load.toFixed(2) : load.toFixed(1)}× scene default · ${
            { light: 'lighter', default: 'as shipped', heavy: 'heavier', hot: 'phone-hostile' }[band]
          }`;
        }
      };

      const apply = () => {
        const cfg = read();
        applyThemeLive(cfg);

        // Panes follow the PICKED kind, not the effective one — "photo" with
        // nothing uploaded yet still has to show the upload row.
        for (const pane of document.querySelectorAll<HTMLElement>('[data-bgpane]')) {
          pane.hidden = !pane.dataset.bgpane!.split(' ').includes(cfg.background);
        }
        const hdrPane = document.querySelector<HTMLElement>('[data-hdrpane]');
        if (hdrPane) hdrPane.hidden = !cfg.hdrCustom;
        for (const pane of document.querySelectorAll<HTMLElement>('[data-hdrscene]')) {
          pane.hidden = cfg.hdrScene === 'none';
        }
        const surfPane = document.querySelector<HTMLElement>('[data-surfpane]');
        if (surfPane) surfPane.hidden = !cfg.surfaceCustom;
        const brandPane = document.querySelector<HTMLElement>('[data-brandpane]');
        if (brandPane) brandPane.hidden = !cfg.brandCustom;
        // Slider readouts…
        for (const out of document.querySelectorAll<HTMLElement>('[data-val]')) {
          const v = cfg[out.dataset.val as keyof typeof cfg];
          out.textContent = out.dataset.fmt === 'pct' ? `${Math.round(Number(v) * 100)}%` : `${v ?? ''}${out.dataset.unit ?? ''}`;
        }
        // …and the filled part of every track.
        for (const r of document.querySelectorAll<HTMLInputElement>('.acct-panel input[type=range]')) {
          const lo = Number(r.min), hi = Number(r.max);
          r.style.setProperty('--p', `${((Number(r.value) - lo) / (hi - lo || 1)) * 100}%`);
        }
        score(cfg);
      };

      // --------------------------------------------------------------- undo
      // A stack of whole-form snapshots, one step per SAVE — a slider drag is
      // one debounced save, so it undoes in one press. `base` is the last
      // saved state; an undo writes it back and re-posts, and the dedupe below
      // keeps that round trip from pushing a step of its own.
      const undoBtn = document.getElementById('acct-undo') as HTMLButtonElement;
      const stack: string[] = [];
      const snap = () => new URLSearchParams([...new FormData(form)] as [string, string][]).toString();
      let base = snap();
      const syncUndo = () => undoBtn.classList.toggle('hidden', !stack.length);
      const remembered = readDesktopCheckpoint<{ base: string; stack: string[] }>('account-theme-undo');
      if (remembered?.base === base && Array.isArray(remembered.stack) && remembered.stack.every(s => typeof s === 'string')) {
        stack.push(...remembered.stack.slice(-50)); syncUndo();
      }
      checkpointTheme = () => saveDesktopState('account-theme-undo', { base, stack });

      onSaved = (f) => {
        if (f !== form) return;
        const now = snap();
        if (now === base) return;
        stack.push(base);
        if (stack.length > 50) stack.shift();
        base = now;
        syncUndo();
      };

      const undo = () => {
        const prev = stack.pop();
        if (prev === undefined) return;
        const p = new URLSearchParams(prev);
        for (const el of [...form.elements] as HTMLInputElement[]) {
          // Buttons carry a name+value the server reads (`reset=1`) but never
          // appear in a snapshot — writing '' into one disarms it.
          if (!el.name || el.type === 'submit' || el.type === 'button') continue;
          if (el.type === 'checkbox') el.checked = p.has(el.name);
          else if (el.type === 'radio') el.checked = p.get(el.name) === el.value;
          else el.value = p.get(el.name) ?? '';
        }
        curPreset = (document.getElementById('th-preset') as HTMLSelectElement).value as ThemePreset;
        base = prev;
        syncUndo();
        apply();
        autosave(form, 0);
      };

      undoBtn.addEventListener('click', undo);
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'z' || !(e.metaKey || e.ctrlKey) || e.shiftKey || e.altKey) return;
        // Text fields keep their own native undo.
        if ((e.target as HTMLElement).closest('textarea, input:not([type=range]):not([type=color]):not([type=checkbox]):not([type=radio])')) return;
        e.preventDefault();
        undo();
      });

      // Preview on every keystroke of a drag, save once it settles.
      const live = () => {
        apply();
        autosave(form, 500);
      };
      // The style list belongs to the picked set: swap it, then repaint.
      const iconSetSel = document.getElementById('th-iconset') as HTMLSelectElement;
      const iconStyleSel = document.getElementById('th-iconstyle') as HTMLSelectElement;
      const ICON_STYLES = JSON.parse(iconStyleSel.dataset.styles!) as Record<string, string[]>;
      iconSetSel.addEventListener('change', () => {
        const styles = ICON_STYLES[iconSetSel.value] ?? [];
        iconStyleSel.replaceChildren(...styles.map((st) => new Option(st.replace('-', ' '), st)));
        iconStyleSel.value = styles[0] ?? '';
        iconStyleSel.dispatchEvent(new Event('change', { bubbles: true }));
        iconStyleSel.closest<HTMLElement>('[data-icon-style]')!.hidden = !styles.length;
        live();
      });
      form.addEventListener('input', live);
      // The background knobs are form="theme-form" but live in another panel,
      // so their events never bubble through the <form> element itself.
      document.getElementById('background')?.addEventListener('input', live);
      document.getElementById('header')?.addEventListener('input', live);

      // "Reset to default" is a real submit (it navigates and re-renders with
      // stock values) — don't let the input listener race a save against it.
      form.addEventListener('submit', () => clearTimeout(pending.get(form)));

      // The form field each preset-owned knob lives in. rollPreset() decides
      // WHICH ones move (only those still at the outgoing preset's value —
      // a header, background or accent the user set is theirs and stays).
      const KNOB_FIELDS: Record<string, (typeof PRESET_KNOBS)[number]> = {
        'th-accent': 'accent', 'th-alpha': 'glassAlpha', 'th-blur': 'glassBlur',
        'th-radius': 'radius', 'th-density': 'density', 'th-bg': 'background',
        'th-border': 'border', 'th-rim': 'rim', 'th-shadow': 'shadow',
        'th-surface': 'surface', 'th-surface2': 'surface2', 'th-line': 'line',
        'th-surf': 'surfaceCustom',
        'th-hpad': 'hdrPad', 'th-halpha': 'hdrAlpha', 'th-hblur': 'hdrBlur',
        'th-hborder': 'hdrBorder', 'th-hhalo': 'hdrHalo', 'th-hsweep': 'hdrSweep',
        'th-hbg': 'hdrBg', 'th-hcustom': 'hdrCustom',
      };
      let curPreset = (document.getElementById('th-preset') as HTMLSelectElement).value as ThemePreset;

      document.getElementById('th-preset')?.addEventListener('change', (e) => {
        const next = (e.target as HTMLSelectElement).value as ThemePreset;
        if (!PRESETS[next]) return;
        // read() already sees the NEW preset in the select — roll from the old.
        const rolled = rollPreset({ ...read(), preset: curPreset }, next);
        curPreset = next;
        for (const [id, key] of Object.entries(KNOB_FIELDS)) {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (!el) continue;
          if (el.type === 'checkbox') el.checked = rolled[key] as boolean;
          else el.value = String(rolled[key]);
        }
        live();
      });

      // Same idea for scenes: each carries its own colours and knob defaults.
      document.getElementById('th-scene')?.addEventListener('change', (e) => {
        const sc = SCENES[(e.target as HTMLSelectElement).value as SceneId];
        if (!sc) return;
        set('th-c1', sc.colors[0]);
        set('th-c2', sc.colors[1]);
        set('th-c3', sc.colors[2]);
        set('th-speed', sc.speed);
        set('th-glow', sc.glow);
        set('th-scale', sc.scale);
        set('th-warp', sc.warp);
        set('th-bgop', sc.opacity);
        resetGfx('bg', sc); // each preset has its own render scale
        live();
      });

      // The banner shares the scene catalogue, so it loads the same defaults —
      // scaled coarser, because the bar is a far wider box than the page.
      document.getElementById('th-hscene')?.addEventListener('change', (e) => {
        const sc = SCENES[(e.target as HTMLSelectElement).value as SceneId];
        if (!sc) return live(); // 'none' — nothing to preload, just save it
        set('th-hc1', sc.colors[0]);
        set('th-hc2', sc.colors[1]);
        set('th-hc3', sc.colors[2]);
        set('th-hspeed', sc.speed);
        set('th-hglow', sc.glow);
        set('th-hscale', Math.round(sc.scale * HDR_SCALE * 100) / 100);
        set('th-hwarp', sc.warp);
        set('th-hop', sc.opacity);
        resetGfx('hdr', sc);
        live();
      });

      apply(); // pane visibility + readouts on load, without saving
    }
  </script>
</AppLayout>
