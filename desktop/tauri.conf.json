{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rimeward",
  "version": "0.4.8",
  "identifier": "io.frostdev.rimeward",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rimeward",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "unzip"
        ]
      }
    },
    "resources": [
      "runtime/"
    ],
    "externalBin": [
      "binaries/rimeward-node"
    ]
  }
}
