{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "dashboard",
  "description": "The dashboard page (served by the site) may ask this app for a ward's local browser.",
  "windows": [
    "main",
    "ward-*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "local": true,
  "permissions": [
    "core:default",
    "allow-ward-browser",
    "allow-ward-touch"
  ]
}
